{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "myhappa",
      "public": "www",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/r/**",
          "destination": "/r.html"
        },
        {
          "source": "/download",
          "destination": "/download.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31556926; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
            },
            {
              "key": "Content-Security-Policy",
              "value": "frame-ancestors 'none'"
            },
            {
              "key": "Content-Security-Policy-Report-Only",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firebaseinstallations.googleapis.com https://apis.google.com https://www.google.com https://api.github.com; worker-src 'self'; manifest-src 'self'; frame-src https://happa-bfc07.firebaseapp.com; object-src 'none'; base-uri 'self'; form-action 'self'"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/@(index.html|service-worker.js|download|download.html|changelog.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(service-worker).@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/icons/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/templates/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/r.html",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/r/**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "happaapp",
      "public": "hosting-redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://myhappa.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://myhappa.web.app/:path",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31556926; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
            }
          ]
        }
      ]
    },
    {
      "site": "happa-bfc07",
      "public": "hosting-redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://myhappa.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://myhappa.web.app/:path",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31556926; includeSubDomains; preload"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8181
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}

{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "myhappa",
      "public": "www",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/r/**",
          "destination": "/r.html"
        },
        {
          "source": "/download",
          "destination": "/download.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/@(index.html|service-worker.js|download|download.html|changelog.json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/!(service-worker).@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/manifest.webmanifest",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/manifest+json"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/icons/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/templates/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/@(r.html|r/**)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow, noarchive"
            },
            {
              "key": "Referrer-Policy",
              "value": "no-referrer"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "site": "happaapp",
      "public": "hosting-redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://myhappa.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://myhappa.web.app/:path",
          "type": 301
        }
      ]
    },
    {
      "site": "happa-bfc07",
      "public": "hosting-redirect",
      "redirects": [
        {
          "source": "/",
          "destination": "https://myhappa.web.app/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://myhappa.web.app/:path",
          "type": 301
        }
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8181
    },
    "auth": {
      "port": 9099
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}

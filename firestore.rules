rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPERS
    // Production collections use the 'users' collection as the source of a
    // caller's profile; development (dev_ prefix) collections use 'dev_users'.
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath(usersCol) {
      return /databases/$(database)/documents/$(usersCol)/$(request.auth.uid);
    }

    // Approved = has a profile whose status is not pending/rejected and whose role is known.
    // Legacy approved profiles have status 'active', 'approved' or no status field at all.
    function isApprovedIn(usersCol) {
      return isSignedIn()
        && exists(profilePath(usersCol))
        && !(get(profilePath(usersCol)).data.get('status', '') in ['pending', 'rejected'])
        && get(profilePath(usersCol)).data.get('role', '') in ['owner', 'manager', 'staff'];
    }

    function isOwnerIn(usersCol) {
      return isApprovedIn(usersCol) && get(profilePath(usersCol)).data.get('role', '') == 'owner';
    }

    function isApproved() {
      return isApprovedIn('users');
    }

    function isAdmin() {
      return isOwnerIn('users');
    }

    // Shared business data: every approved user (owner/manager/staff) can read/write.
    function businessCollections() {
      return [
        'purchases', 'retailSales', 'wholesaleSales', 'items', 'expenses',
        'stockAdjustments', 'withdrawals', 'cashManagement', 'cashSessions',
        'settings', 'itemFrequency', 'notifications', 'autoSaves', 'drafts',
        'counters', 'personalExpenses', 'personalExpenseDays'
      ];
    }

    function devBusinessCollections() {
      return [
        'dev_purchases', 'dev_retailSales', 'dev_wholesaleSales', 'dev_items', 'dev_expenses',
        'dev_stockAdjustments', 'dev_withdrawals', 'dev_cashManagement', 'dev_cashSessions',
        'dev_settings', 'dev_itemFrequency', 'dev_notifications', 'dev_autoSaves', 'dev_drafts',
        'dev_counters', 'dev_personalExpenses', 'dev_personalExpenseDays'
      ];
    }

    // --- bills (purchases / retail / wholesale sales) ---

    function billCollections() {
      return ['purchases', 'retailSales', 'wholesaleSales'];
    }

    // --- bill edit window (#87; days per role in Roles & access, #84) ---
    // Clock: the bill's `createdAt`, the server time of its first save
    // (firestore-service.js saveBill; validBillCreate requires it to equal
    // request.time and nobody but the owner can change it). Bills without a
    // server createdAt (saved before #87 / by old apps) are owner-only.
    // Days: settings/app.roleAccess.<role>.editDays (int 0-30, else 2).
    // settings/app is already read for the clientVersion gate on bill writes.
    function settingsAppPath(usersCol) {
      return /databases/$(database)/documents/$(usersCol == 'users' ? 'settings' : 'dev_settings')/app;
    }

    function billEditDays(usersCol) {
      return billEditDaysFor(usersCol, get(profilePath(usersCol)).data.get('role', ''));
    }

    function billEditDaysFor(usersCol, role) {
      let p = settingsAppPath(usersCol);
      let access = exists(p) ? get(p).data.get('roleAccess', {}) : {};
      let roleAccess = access is map ? access.get(role, {}) : {};
      let d = roleAccess is map ? roleAccess.get('editDays', 2) : 2;
      return (d is int && d >= 0 && d <= 30) ? d : 2;
    }

    function withinBillWindowFor(usersCol, role) {
      let c = resource.data.get('createdAt', null);
      return c is timestamp && request.time < c + duration.value(billEditDaysFor(usersCol, role), 'd');
    }

    function canDeleteBill(usersCol) {
      // Bills are voided, not deleted (#75): only the owner deletes (test data, a voided bill
      // for good, Clear Data). resource is null when deleting a doc that is already gone (no-op).
      return isOwnerIn(usersCol) || (isApprovedIn(usersCol) && resource == null);
    }

    // --- void (#75) and edit records (#121) ---

    function voidFields() {
      return ['voided', 'voidedAt', 'voidedBy', 'voidedByName', 'voidReason'];
    }

    // Changing these on a bill needs its edit record (edits/{editCount}) in the same write
    // (firestore-service.js updateBillChecked; bill-edits.js EDIT_FIELDS without the notes).
    function editLoggedFields() {
      return ['items', 'customerName', 'grandTotal', 'amountPayable', 'total', 'billTotal', 'saleTotal',
              'laborCharges', 'payment', 'cashPayment', 'onlinePayment', 'dueAmount'];
    }

    function billPath(usersCol, base, docId) {
      return /databases/$(database)/documents/$(usersCol == 'users' ? base : 'dev_' + base)/$(docId);
    }

    // A void or edit reason: 3 to 300 characters (bill-edits.js REASON_MIN / REASON_MAX).
    function reasonOk(r) {
      return r is string && r.trim().size() >= 3 && r.size() <= 300;
    }

    // A void: only the void fields change (and openDue to false, clientVersion for the gate); by
    // the caller, at the server time, with a reason; never with payments recorded after the bill
    // was saved (their cash legs would be left without a bill); the owner any bill, anyone else
    // their own bill inside the edit window (who could delete a bill before #75). A voided bill
    // never changes again.
    function voidOk(usersCol, role, changed) {
      let d = request.resource.data;
      return changed.hasOnly(['voided', 'voidedAt', 'voidedBy', 'voidedByName', 'voidReason', 'openDue', 'clientVersion'])
        && (!changed.hasAny(['clientVersion']) || (d.clientVersion is int && d.clientVersion >= 3))
        && d.get('voided', false) == true
        && d.get('voidedAt', null) == request.time
        && d.get('voidedBy', null) == request.auth.uid
        && reasonOk(d.get('voidReason', null))
        && (!('voidedByName' in d) || (d.voidedByName is string && d.voidedByName.size() <= 200))
        && d.get('openDue', false) == false
        && resource.data.get('payments', []).size() == 0
        && (role == 'owner'
            || (resource.data.get('userId', null) == request.auth.uid && withinBillWindowFor(usersCol, role)));
    }

    // editCount only goes up by one, together with the creation of its record edits/{n}.
    function editCountOk(usersCol, base, docId) {
      let n = request.resource.data.get('editCount', null);
      return n is int && n == resource.data.get('editCount', 0) + 1
        && existsAfter(/databases/$(database)/documents/$(usersCol == 'users' ? base : 'dev_' + base)/$(docId)/edits/$(string(n)));
    }

    // An edit record: append-only and immutable; by the caller at the server time with a
    // reason; numbered with the bill's new editCount, which the same write raises by one;
    // it names every logged field the write changed (items through itemsChanged).
    function validEditCreate(usersCol, base, billId, editId) {
      let d = request.resource.data;
      let after = getAfter(billPath(usersCol, base, billId)).data;
      let before = get(billPath(usersCol, base, billId)).data;
      let n = after.get('editCount', null);
      let moved = after.diff(before).affectedKeys().intersection(editLoggedFields().toSet());
      return isApprovedIn(usersCol)
        && d.keys().hasOnly(['n', 'at', 'by', 'byName', 'reason', 'fields', 'lines', 'itemsChanged'])
        && n is int && editId == string(n) && d.get('n', null) == n
        && n == before.get('editCount', 0) + 1
        && d.get('by', null) == request.auth.uid
        && d.get('at', null) == request.time
        && reasonOk(d.get('reason', null))
        && (!('byName' in d) || (d.byName is string && d.byName.size() <= 200))
        && d.get('fields', {}) is map && d.get('fields', {}).size() <= 20
        && d.get('fields', {}).keys().toSet().hasAll(moved.difference(['items'].toSet()))
        && d.get('itemsChanged', false) == moved.hasAny(['items'])
        && d.get('lines', []) is list && d.get('lines', []).size() <= 200;
    }

    // Full edits (the owner is handled in canUpdateBill): a manager, or the bill's
    // creator, inside the edit window; createdAt never changes.
    function canFullyEditBill(usersCol, role) {
      return (role == 'manager'
              || (resource.data.get('userId', null) != null
                  && resource.data.get('userId', null) == request.auth.uid))
        && withinBillWindowFor(usersCol, role)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // Everyone else may only touch payment/due bookkeeping written by the app:
    // payments (outstanding.js applyPaymentTransaction / applyWriteOffTransaction,
    // which also stamp `paidAt`, the time of the payment, #163), clearing (markAsCleared,
    // wholesale markSaleAsCleared) and the legacy backfill (openDue, clientVersion,
    // a missing numeric timestamp, bounded like legacyBackfillOnly). `timestamp` and
    // `id` may only be filled in, never changed.
    function bookkeepingOnly(docId, changed) {
      return changed.hasOnly([
          'payment', 'payments', 'dueAmount', 'openDue', 'clientVersion', 'paidAt',
          'cleared', 'clearedAt', 'clearedBy', 'clearedByName',
          'timestamp', 'id'
        ])
        && (!changed.hasAny(['timestamp'])
            || (!(resource.data.get('timestamp', null) is number)
                && request.resource.data.timestamp is number
                && backfillTimeOk(request.resource.data.timestamp, resource.data.get('timestamp', null),
                     resource.data.get('date', null))))
        && (!changed.hasAny(['id']) || (!('id' in resource.data) && request.resource.data.id == docId));
    }

    // --- money validation (#19, #65) ---
    // A bill write already uses much of the 1000 expressions rules evaluate per
    // request, so these follow the shape the app writes (payment.cash / online /
    // due, with top-level copies) rather than every legacy shape readPayment() reads.

    // A payment amount as the app writes it (round2): a number >= 0 in whole paise
    // (NaN fails >= 0; for Infinity the paise test is NaN, so it fails too).
    function moneyOk(v) {
      return v is number && v >= 0 && math.abs(v * 100 - math.round(v * 100)) < 0.001;
    }

    function moneyOrAbsent(m, key) {
      return !(key in m) || moneyOk(m[key]);
    }

    function totalOk(m, key) {
      return !(key in m) || (m[key] is number && m[key] > -10000000000 && m[key] < 10000000000);
    }

    // The bill's due before this write, as readPayment() reads it (nested
    // payment.due first); null when it isn't stored as a number.
    function storedDue() {
      let p = resource.data.get('payment', {});
      let due = (p is map && 'due' in p) ? p.due : resource.data.get('dueAmount', resource.data.get('due', null));
      return due is number ? due : null;
    }

    // Money on a bill created or fully edited by a non-owner: totals are finite
    // numbers, payment amounts are money and, when any of them changes, cash +
    // online + written off + due is at most the bill total + Rs 1 (the bill
    // screen's split check, money.js SPLIT_TOLERANCE: "Cash" or "Due" fills in the
    // total rounded to the rupee). The total is read as billTotal() reads it
    // (grandTotal, amountPayable, total, then billTotal / saleTotal). Only
    // tools/migrate writes opening records; the app never writes the legacy
    // amountPaid / due that readPayment() would also read.
    function changedMoneyOk(keys) {
      return !keys.hasAny(['openingBalance', 'amountPaid', 'due'])
        && (keys.hasAny(['total', 'grandTotal', 'amountPayable', 'billTotal', 'saleTotal',
                         'payment', 'cashPayment', 'onlinePayment', 'dueAmount'])
            ? billMoneyOk(request.resource.data, request.resource.data.get('payment', {}))
            : true);
    }

    function billMoneyOk(d, p) {
      return p is map
        && moneyOrAbsent(p, 'cash') && moneyOrAbsent(p, 'online') && moneyOrAbsent(p, 'due')
        && moneyOrAbsent(p, 'writtenOff') && moneyOrAbsent(p, 'total')
        && moneyOrAbsent(d, 'cashPayment') && moneyOrAbsent(d, 'onlinePayment') && moneyOrAbsent(d, 'dueAmount')
        && totalOk(d, 'total') && totalOk(d, 'grandTotal') && totalOk(d, 'amountPayable')
        && totalOk(d, 'billTotal') && totalOk(d, 'saleTotal')
        && p.get('cash', d.get('cashPayment', 0)) + p.get('online', d.get('onlinePayment', 0))
           + p.get('writtenOff', 0) + p.get('due', d.get('dueAmount', 0))
           <= (d.get('grandTotal', 0) != 0 ? d.grandTotal
               : d.get('amountPayable', 0) != 0 ? d.amountPayable
               : d.get('total', 0) != 0 ? d.total
               : d.get('billTotal', 0) != 0 ? d.billTotal
               : d.get('saleTotal', 0)) + 1.0101;
    }

    // payments[] may only grow by one entry; existing entries stay unchanged and
    // the new entry has a numeric amount >= 0 (#19).
    function appendsOneEntry(field) {
      let oldList = resource.data.get(field, []);
      let newList = request.resource.data.get(field, []);
      return oldList is list && newList is list
        && newList.size() == oldList.size() + 1
        && (oldList.size() == 0 || newList[0:oldList.size()] == oldList)
        && newList[oldList.size()] is map
        && newList[oldList.size()].get('amount', null) is number
        && newList[oldList.size()].amount >= 0;
    }

    // Money moves only with the due (#65). A payment or write-off writes
    // payment.cash, online and due as money; cash, online and written off never
    // go down, each goes up by what the new payments[] entry (amount > 0) says
    // (due-payments.js entryParts: a write-off, else its cash / online parts,
    // else all cash; half a paisa for round2 of older values), and the due goes
    // down by the same (1 paisa either way, outstanding.js PAYMENT_TOLERANCE).
    // Without an entry no money moves and the due only drops when a due under
    // 1 paisa is written off to 0. So a member can neither take money off a bill
    // nor lower a due without money, and with the split check on creates and
    // edits nobody pays more than the bill total.
    function paymentMoneyOk(changed, p, rp, before) {
      return moneyOk(p.get('cash', null)) && moneyOk(p.get('online', null)) && moneyOk(p.get('due', null))
        && moneyOrAbsent(p, 'writtenOff') && moneyOrAbsent(p, 'total')
        && rp is map && before != null
        && entryMatches(
             p.cash - rp.get('cash', resource.data.get('cashPayment', 0)),
             p.online - rp.get('online', resource.data.get('onlinePayment', 0)),
             p.get('writtenOff', 0) - rp.get('writtenOff', 0),
             before - p.due,
             changed.hasAny(['payments']) ? request.resource.data.payments[request.resource.data.payments.size() - 1] : {});
    }

    function entryMatches(cash, online, wo, settled, e) {
      return !('amount' in e)
        ? math.abs(cash) <= 0.005 && math.abs(online) <= 0.005 && math.abs(wo) <= 0.005
          && (math.abs(settled) <= 0.000001 || (settled <= 0.0101 && request.resource.data.payment.due == 0))
        : e.amount > 0 && math.abs(cash + online + wo - settled) <= 0.0101
          && (e.get('kind', '') == 'writeOff'
              ? math.abs(cash) <= 0.005 && math.abs(online) <= 0.005 && math.abs(wo - e.amount) <= 0.005
              : math.abs(wo) <= 0.005 && partsMatch(cash, online, e.amount,
                  ('cash' in e || 'online' in e) ? e.get('cash', 0) : e.amount, e.get('online', 0)));
    }

    function partsMatch(cash, online, amount, ec, eo) {
      return ec >= 0 && eo >= 0
        && math.abs(cash - ec) <= 0.005 && math.abs(online - eo) <= 0.005 && math.abs(amount - ec - eo) <= 0.005;
    }

    // A new payments[] entry carries its time (`at`, ms) within 10 minutes of the
    // server's: payments and write-offs are transactions, so they never queue
    // offline, and a back- or forward-dated entry would move drawer cash to
    // another day (due-payments.js counts an entry on the day of its `at`).
    function entryTimeOk() {
      let at = request.resource.data.payments[request.resource.data.payments.size() - 1].get('at', null);
      return at is number && at > request.time.toMillis() - 600000 && at < request.time.toMillis() + 600000;
    }

    // A due is cleared only when it is settled in the same write (#104: paid or
    // written off), by the caller, and openDue goes false only with it
    // (firestore-service.js hasDue).
    function clearOk(changed, d, due) {
      return (!changed.hasAny(['cleared']) || (d.get('cleared', false) == true && due <= 0.0101))
        && (!changed.hasAny(['clearedBy']) || d.clearedBy == request.auth.uid)
        && (!changed.hasAny(['openDue']) || d.openDue == true || d.get('cleared', false) == true || due <= 0.0101);
    }

    // Payment bookkeeping by someone who may not fully edit the bill: amounts are
    // money, payment.due and dueAmount agree, payments[] is append-only, money
    // moves only with the due (paymentMoneyOk), dues are cleared only when settled
    // (clearOk), and `paidAt` is written only with a new payments[] entry and
    // equals that entry's `at` (outstanding.js applyPaymentTransaction /
    // applyWriteOffTransaction; markAsCleared and wholesale markSaleAsCleared go
    // through them). Older apps append without `paidAt`; that stays allowed.
    function paymentEditOk(changed) {
      let d = request.resource.data;
      return (!changed.hasAny(['dueAmount'])
              || (moneyOk(d.dueAmount) && d.dueAmount == d.get('payment', {}).get('due', d.dueAmount)))
        && (!changed.hasAny(['payments']) || (appendsOneEntry('payments') && entryTimeOk()))
        && (!changed.hasAny(['paidAt'])
            || (d.paidAt is number && changed.hasAny(['payments'])
                && d.paidAt == d.payments[d.payments.size() - 1].get('at', null)))
        && (changed.hasAny(['payment', 'payments', 'dueAmount'])
            ? changed.hasAny(['payment']) && paymentMoneyOk(changed, d.payment, resource.data.get('payment', {}), storedDue())
            : true)
        && (changed.hasAny(['cleared', 'clearedBy', 'openDue'])
            ? clearOk(changed, d, d.get('payment', {}).get('due', d.get('dueAmount', 0)))
            : true);
    }

    // The caller is approved (businessAccess); their role is read once and the
    // changed keys worked out once (rules allow 1000 expressions per request).
    // Only an owner may change userId.
    function canUpdateBill(usersCol, base, docId) {
      return billUpdateAs(usersCol, base, docId, get(profilePath(usersCol)).data.get('role', ''),
        request.resource.data.diff(resource.data).affectedKeys());
    }

    // A voided bill never changes (owner included); a void is voidOk; editCount moves only
    // with its edit record; full edits by non-owners that change a logged field need one (#121)
    // and never touch payments / paidAt (only bookkeeping appends to them).
    function billUpdateAs(usersCol, base, docId, role, changed) {
      // Ternaries keep the expensive checks off the paths that don't need them.
      return resource.data.get('voided', false) == true ? false
        : changed.hasAny(voidFields()) ? voidOk(usersCol, role, changed)
        : changed.hasAny(['editCount']) && !editCountOk(usersCol, base, docId) ? false
        : role == 'owner' ? true
        : changed.hasAny(['userId']) ? false
        : canFullyEditBill(usersCol, role) && !changed.hasAny(['payments', 'paidAt'])
          && (!changed.hasAny(editLoggedFields()) || changed.hasAny(['editCount'])) ? changedMoneyOk(changed)
        : bookkeepingOnly(docId, changed) ? paymentEditOk(changed)
        : false;
    }

    // New bills: the creator's own uid (when set), well-formed money (changedMoneyOk),
    // no payment history, cleared state, edit count or void (the app never sends them on a
    // new bill), and, when sent, createdAt = the server time of this write (older apps don't send it).
    function validBillCreate() {
      return request.resource.data.get('userId', request.auth.uid) == request.auth.uid
        && !request.resource.data.keys().hasAny(['payments', 'paidAt', 'cleared', 'editCount',
             'voided', 'voidedAt', 'voidedBy', 'voidedByName', 'voidReason'])
        && changedMoneyOk(request.resource.data.keys())
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
    }

    // ============================================
    // CASH, EXPENSES, STOCK ADJUSTMENTS, ITEMS, COUNTERS (#18)
    // The owner may write these freely (repairs, backup restore). Everyone else
    // is limited to the writes the app makes.
    // ============================================

    function isMember(usersCol) {
      return isApprovedIn(usersCol) && !isManagerIn(usersCol);
    }

    // Who created a record (expenses carry userId and createdBy).
    function createdByCaller() {
      return resource.data.get('userId', resource.data.get('createdBy', null)) == request.auth.uid;
    }

    // Members may change their own record for 24 hours after it was made
    // (fixing a typo); after that only an owner/manager may.
    function withinEditWindow() {
      let t = resource.data.get('timestamp', null);
      return t is number
        && t > request.time.toMillis() - 86400000
        && t < request.time.toMillis() + 86400000;
    }

    // Legacy backfill (firestore-service.js backfillLegacyTimestamps): fills a
    // missing numeric timestamp (+ clientVersion on stock records), nothing else.
    // The value is the one the app derives (stock-replay.js eventTime), never in
    // the future: an old Firestore Timestamp's millis, else the record's `date`.
    function legacyBackfillOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['timestamp', 'clientVersion'])
        && changed.hasAny(['timestamp'])
        && !(resource.data.get('timestamp', null) is number)
        && request.resource.data.timestamp is number
        && backfillTimeOk(request.resource.data.timestamp, resource.data.get('timestamp', null),
             resource.data.get('date', null));
    }

    function backfillTimeOk(t, old, day) {
      return t <= request.time.toMillis()
        && (old is timestamp ? t == old.toMillis()
          : day is timestamp ? t == day.toMillis()
          : day is string ? backfillDayOk(t, day)
          : true);
    }

    // A date string the rules can read: YYYY-MM-DD[...] or DD/MM/YYYY[, time].
    function backfillDayOk(t, s) {
      return s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ].*)?$')
          ? nearDay(t, int(s[0:4]), int(s[5:7]), int(s[8:10]))
        : s.matches('^[0-9]{1,2}/[0-9]{1,2}/[0-9]{4}([, ].*)?$')
          ? nearDay(t, int(s.split('/')[2][0:4]), int(s.split('/')[1]), int(s.split('/')[0]))
        : true;
    }

    // Within that calendar day, give or take a day for the phone's time zone (the app
    // reads YYYY-MM-DD as UTC midnight and DD/MM/YYYY as local time).
    function nearDay(t, y, m, d) {
      let start = timestamp.date(y, m, d).toMillis();
      return t >= start - 86400000 && t < start + 172800000;
    }

    function amountOk() {
      return request.resource.data.get('amount', null) is number && request.resource.data.amount >= 0;
    }

    // Expenses / withdrawals: anyone approved records their own, with a numeric amount
    // and a numeric `timestamp` that is not in the future (10 minutes' slack for the
    // phone's clock): startSaveExpense sets it from the creation time, startSaveWithdrawal
    // from the later of the creation time and the picked day (Money refuses a future day).
    // A queued offline record arrives later, so there is no lower bound.
    function validLedgerCreate() {
      return amountOk() && request.resource.data.get('userId', null) == request.auth.uid
        && request.resource.data.get('timestamp', null) is number
        && request.resource.data.timestamp <= request.time.toMillis() + 600000;
    }

    function expenseEditOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['type', 'personName', 'amount', 'remarks', 'paymentMode', 'updatedAt', 'updatedBy', 'updatedByName'])
        && (!changed.hasAny(['amount']) || amountOk());
    }

    // --- expense date and payment mode (#118) ---
    // paymentMode: 'cash' | 'online' (none = cash). day: the local (IST) day the
    // expense counts on, YYYY-MM-DD, never in the future (1 hour for a fast phone clock).
    function expenseDayStart(day) {
      return timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10])) - duration.value(330, 'm');
    }

    function expenseFieldsOk(d) {
      return (!('paymentMode' in d) || d.paymentMode in ['cash', 'online'])
        && (!('day' in d) || (dayKeyOk(d.day) && expenseDayStart(d.day) <= request.time + duration.value(1, 'h')));
    }

    // A new expense by anyone but the owner that names its day may be dated back at most
    // the role's edit window (roleAccess.<role>.editDays, as bills; the app allows exactly
    // that), plus 3 days for a phone that saved it offline. Its `date` (what the figures
    // read) must be on that day: "D/M/YYYY, …" as en-IN writes it, with or without leading
    // zeros. Older apps name the day only on personal expenses (today, from the date).
    function expenseDateOnDay(d) {
      return d.get('date', null) is string
        && d.date.matches('^0?' + string(int(d.day[8:10])) + '/0?' + string(int(d.day[5:7])) + '/' + d.day[0:4] + '([^0-9].*)?$');
    }

    function expenseDayInWindow(usersCol) {
      let d = request.resource.data;
      return !('day' in d)
        || (expenseDateOnDay(d)
            && request.time < expenseDayStart(d.day) + duration.value(billEditDays(usersCol) + 4, 'd'));
    }

    function canUpdateExpense(usersCol) {
      return legacyBackfillOnly()
        || (isManagerIn(usersCol)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']) || amountOk()))
        || (createdByCaller() && withinEditWindow() && expenseEditOk());
    }

    function canDeleteExpense(usersCol) {
      return isManagerIn(usersCol) || resource == null || (createdByCaller() && withinEditWindow());
    }

    // Stock adjustments: owner/manager record them (stock.js applyStockAdjustment; the
    // Stock › Adjustment tab and Set opening stock are not open to members, #64).
    function validAdjustmentCreate() {
      let d = request.resource.data;
      return d.get('userId', null) == request.auth.uid
        && d.get('adjustType', null) in ['add', 'remove', 'set']
        && d.get('quantity', null) is number && d.quantity >= 0
        && d.get('itemId', null) != null;
    }

    // --- cash sessions (cashManagement) ---

    // cash-management.js signIn → firestore-service.js openCashSession: the day's
    // session (#38) at cash_<date>, with the fields signIn sends and no entries yet.
    // (Every happa version opens cash this way; the old random-id .add() is gone.)
    function validCashCreate(docId) {
      let d = request.resource.data;
      return dayKeyOk(d.get('date', null)) && docId == 'cash_' + d.date
        && d.keys().hasOnly(['id', 'date', 'openingBalance', 'signInTime', 'userId', 'userName',
                             'signedOut', 'duePayments', 'openingNotes'])
        && d.get('id', docId) == docId
        && d.get('openingBalance', null) is number && d.openingBalance >= 0
        && d.get('signedOut', null) == false
        && d.get('userId', null) == request.auth.uid
        && d.get('duePayments', []) == []
        && d.get('signInTime', '') is string
        && d.get('userName', '') is string
        && d.get('openingNotes', '') is string;
    }

    // Deposits and due-payment legs are appended one at a time (arrayUnion, or
    // outstanding.js applyPaymentTransaction). Also allowed on a closed session:
    // an entry queued offline must not be lost because another device closed it.
    function cashAppendOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 1
        && changed.hasOnly(['duePayments', 'cashDeposits'])
        && appendsOneEntry(changed.hasAny(['duePayments']) ? 'duePayments' : 'cashDeposits');
    }

    // A day the app closed automatically without a real count (#101; older
    // apps wrote closingBalance 0 and no `counted`).
    function wasAutoClosedUncounted() {
      return resource.data.get('signedOut', false) == true
        && resource.data.get('autoSignedOut', false) == true
        && resource.data.get('counted', null) != true;
    }

    // Sign-out (counted) or the automatic close of a past day (not counted).
    // A counted sign-out may also replace an automatic close: older apps
    // (v1.3/v1.4) sign out with a plain update and would otherwise lose the count.
    function cashCloseOk() {
      let d = request.resource.data;
      return (resource.data.get('signedOut', false) != true
              || (wasAutoClosedUncounted() && d.get('closingBalance', null) is number))
        && d.get('signedOut', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'closingBalance', 'expectedBalance', 'difference', 'signOutTime', 'signedOut', 'counted',
             'transactions', 'closingNotes', 'flags', 'autoSignedOut', 'autoClosed', 'autoSignOutReason', 'closedBy'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['closedBy']) || d.closedBy == request.auth.uid)
        && (d.get('closingBalance', null) == null || (d.closingBalance is number && d.closingBalance >= 0))
        && (d.get('counted', true) == false || d.get('closingBalance', null) is number)
        && (d.get('expectedBalance', null) == null || d.expectedBalance is number);
    }

    // Recording the real count for a day that was closed without one (#101).
    function cashLateCountOk() {
      let d = request.resource.data;
      let r = resource.data;
      return r.get('signedOut', false) == true
        && (r.get('counted', null) == false || (!('counted' in r) && r.get('autoSignedOut', false) == true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'closingBalance', 'difference', 'counted', 'countedLate', 'countedAt', 'countedBy', 'countedByName'])
        && d.get('closingBalance', null) is number && d.closingBalance >= 0
        && d.get('counted', false) == true
        && d.get('countedBy', null) == request.auth.uid;
    }

    // --- items: owner/manager create and edit; only the owner deletes ---

    function itemFieldsOk(keys) {
      let d = request.resource.data;
      return (!keys.hasAny(['name']) || d.name is string)
        && (!keys.hasAny(['rates']) || d.rates is list)
        && (!keys.hasAny(['saleRates']) || d.saleRates is list)
        && (!keys.hasAny(['wholesaleRates']) || d.wholesaleRates is list);
    }

    // --- item frequency (billing.js updateItemFrequency): only itemFrequency/global, ---
    // { purchase|sale: { <item>: { score, count, lastUsed, effectiveScore } } }, merged
    // in with FieldValue.increment. Only those two maps, and a write never removes an
    // item (no replacing the doc without merge). Rules can't loop over the item keys,
    // so the numbers inside each item are not checked.
    function itemFrequencyOk(docId) {
      let d = request.resource.data;
      let r = resource == null ? {} : resource.data;
      return docId == 'global'
        && d.diff(r).affectedKeys().hasOnly(['purchase', 'sale'])
        && frequencyModeOk(d, r, 'purchase')
        && frequencyModeOk(d, r, 'sale');
    }

    function frequencyModeOk(d, r, mode) {
      return !(mode in d) ? !(mode in r)
        : d[mode] == r.get(mode, null)
          || (d[mode] is map && d[mode].diff(r.get(mode, {})).removedKeys().size() == 0);
    }

    // --- bill-number counters (helpers.js _nextCounterValue): +1 per transaction ---

    function counterFields() {
      return ['next', 'initialized', 'prefix', 'date', 'updatedAt'];
    }

    function validCounterCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(counterFields()) && d.get('next', null) is number && d.next >= 1;
    }

    function counterIncrementOk() {
      let d = request.resource.data;
      let r = resource.data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(counterFields())
        && d.get('next', null) is number
        && (r.get('initialized', false) == true && r.get('next', null) is number
            ? d.next == r.next + 1
            // Not yet seeded from today's bills: may jump forward, never back.
            : (d.next >= 1 && (!(r.get('next', null) is number) || d.next > r.next)));
    }

    function baseName(collection) {
      return collection.matches('dev_.*') ? collection.replace('^dev_', '') : collection;
    }

    function usersOf(collection) {
      return collection.matches('dev_.*') ? 'dev_users' : 'users';
    }

    // --- per-user records: auto-save, drafts, notifications (#18 follow-up) ---
    // Nobody writes another user's records, the owner included; the owner may
    // only delete them (Admin › Clear Data deletes auto-saves and drafts).

    // autoSaves/{uid} (billing.js autoSaveToCloud / deleteAutoSave): that user only.
    function ownAutoSaveWrite(docId) {
      return docId == request.auth.uid
        && request.resource.data.get('userId', request.auth.uid) == request.auth.uid;
    }

    // drafts (billing.js saveDraft / loadDraft / deleteDraft): own drafts only;
    // userId never changes.
    function validDraftCreate() {
      return request.resource.data.get('userId', null) == request.auth.uid;
    }

    function draftUpdateOk() {
      return resource.data.get('userId', null) == request.auth.uid
        && request.resource.data.get('userId', null) == request.auth.uid;
    }

    // notifications: the sender's device writes one doc per recipient
    // (firestore-service.js sendNotification / planNotificationDocs, id
    // <eventKey>_<userId>). The only senders are item adds and rate/name edits
    // (notifyRateChanges, notifyItemEdit), and only owners/managers edit items,
    // so only they may create them: stamped with their own uid and server time,
    // types rate_change and item_edit, these fields only.
    function notificationFields() {
      return ['type', 'action', 'fields', 'itemId', 'itemName', 'itemHindiName',
              'rateType', 'rateTypeLabel', 'oldRate', 'newRate',
              'changedBy', 'changedByUserId', 'userId', 'eventKey', 'read', 'timestamp'];
    }

    function rateValueOk(d, key) {
      return d.get(key, null) is number || d.get(key, null) is list;
    }

    function validNotificationCreate(u, docId) {
      let d = request.resource.data;
      return isManagerIn(u)
        && d.keys().hasOnly(notificationFields())
        && d.get('changedByUserId', null) == request.auth.uid
        && d.get('userId', null) is string && d.userId.size() > 0 && d.userId != request.auth.uid
        && d.get('eventKey', null) is string && docId == d.eventKey + '_' + d.userId
        && d.get('read', null) == false
        && d.get('timestamp', null) == request.time
        && d.get('changedBy', '') is string
        && (d.get('itemId', null) == null || d.itemId is string)
        && d.get('itemName', '') is string
        && d.get('itemHindiName', '') is string
        && (d.get('type', null) == 'rate_change'
            ? d.get('rateType', null) in ['purchase', 'sale', 'wholesale']
              && d.get('rateTypeLabel', '') is string
              && rateValueOk(d, 'oldRate') && rateValueOk(d, 'newRate')
              && !d.keys().hasAny(['action', 'fields'])
            : d.get('type', null) == 'item_edit'
              && d.get('action', null) in ['added', 'updated']
              && d.get('fields', []) is list
              && d.get('fields', []).hasOnly(['name', 'hindiName', 'contactPerson'])
              && !d.keys().hasAny(['rateType', 'rateTypeLabel', 'oldRate', 'newRate']));
    }

    // The recipient marks it read (markNotificationsRead / markAllNotificationsRead).
    function notificationReadOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.get('userId', null) == request.auth.uid
        && changed.hasOnly(['read', 'readAt'])
        && request.resource.data.get('read', false) is bool
        && (!changed.hasAny(['readAt']) || request.resource.data.readAt is number);
    }

    // Delete: the doc's own user (resource == null: already gone, a no-op), or
    // the owner. autoSaves are keyed by uid.
    function canDeleteOwnRecord(base, u, docId) {
      return isOwnerIn(u)
        || (base == 'autoSaves'
            ? docId == request.auth.uid
            : resource == null || resource.data.get('userId', null) == request.auth.uid);
    }

    // --- personal expenses (#98): their own collection, read and written only by the
    // owner and roles with Roles & access › Personal expenses on (default on; one
    // read of settings/app, never for the owner). personalExpenseDays/{YYYY-MM-DD} =
    // { amounts: { <expense id>: amount }, last } holds each day's amounts (one key per
    // expense, written with it) so the cash count and Today still add them up on phones
    // that can't read the expenses. Members and managers may read these totals.
    function personalOn(usersCol) {
      return personalOnAs(usersCol, get(profilePath(usersCol)).data.get('role', ''));
    }

    function personalOnAs(usersCol, role) {
      return role == 'owner' ? true : personalSwitch(settingsAppPath(usersCol), role);
    }

    function personalSwitch(p, role) {
      let access = exists(p) ? get(p).data.get('roleAccess', {}) : {};
      let r = access is map ? access.get(role, {}) : {};
      return (r is map ? r : {}).get('personalExpenses', true) == true;
    }

    function dayKeyOk(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // A personal expense names the day it counts on (`day`, its personalExpenseDays doc).
    function validPersonalCreate() {
      return validLedgerCreate() && request.resource.data.get('category', null) == 'personal'
        && dayKeyOk(request.resource.data.get('day', null));
    }

    // A day doc write changes one key, `last` (an expense id): set to that expense's
    // amount after this write, on its day, or removed when the expense is gone after
    // it. So a repeated delete or a late write is harmless, and nobody can zero the
    // map or add a key for an expense that doesn't exist. Members only touch the key
    // of an expense written in the same batch; managers may also correct a key to
    // the stored amount (rebuild from the rows).
    function validPersonalDay(u, docId) {
      let d = request.resource.data;
      let before = resource == null ? {} : resource.data;
      return dayKeyOk(docId)
        && d.keys().hasOnly(['amounts', 'online', 'last'])
        && d.get('amounts', null) is map
        && d.get('online', {}) is map
        && d.get('last', null) is string && d.last.matches('^[A-Za-z0-9_-]{1,100}$')
        && d.amounts.diff(before.get('amounts', {})).affectedKeys().hasOnly([d.last])
        && d.get('online', {}).diff(before.get('online', {})).affectedKeys().hasOnly([d.last])
        && personalDayKeyOk(u, docId, d,
             /databases/$(database)/documents/$((u == 'dev_users' ? 'dev_' : '') + 'personalExpenses')/$(d.last));
    }

    // `online` flags an expense paid online (#118): set exactly when the expense's
    // paymentMode is 'online', so nobody can move a cash expense out of the drawer.
    // A removed expense may keep a stale flag (older apps don't clear it); it counts nowhere.
    function personalDayKeyOk(u, docId, d, p) {
      return d.last in d.amounts
        ? existsAfter(p) && getAfter(p).data.get('amount', null) == d.amounts[d.last]
          && getAfter(p).data.get('day', '') == docId
          && ((d.last in d.get('online', {}) && d.online[d.last] == true)
              == (getAfter(p).data.get('paymentMode', 'cash') == 'online'))
          && (isManagerIn(u) || !exists(p) || get(p).data != getAfter(p).data)
        : !existsAfter(p);
    }

    // Older apps tagged personal expenses in `expenses`, where every member reads them (#98).
    function personalTagged(m) {
      return m.get('category', '') is string && m.get('category', '').trim().lower() == 'personal';
    }

    function canCreateRecord(base, u, docId) {
      return base == 'autoSaves' ? ownAutoSaveWrite(docId)
        : base == 'drafts' ? validDraftCreate()
        : base == 'notifications' ? validNotificationCreate(u, docId)
        : base == 'expenses' && personalTagged(request.resource.data) ? false
        : base in ['expenses', 'personalExpenses'] && !expenseFieldsOk(request.resource.data) ? false
        : (isOwnerIn(u)
        || (base in billCollections() ? validBillCreate()
          : base == 'expenses' ? validLedgerCreate() && expenseDayInWindow(u)
          : base == 'withdrawals' ? validLedgerCreate()
          : base == 'stockAdjustments' ? isManagerIn(u) && validAdjustmentCreate()
          : base == 'cashManagement' ? validCashCreate(docId)
          // legacy cashSessions (backup only) and settings: owner only (#64)
          : base in ['cashSessions', 'settings'] ? false
          : base == 'items' ? isManagerIn(u) && itemFieldsOk(request.resource.data.keys())
          : base == 'counters' ? validCounterCreate()
          : base == 'itemFrequency' ? itemFrequencyOk(docId)
          : base == 'personalExpenses' ? personalOn(u) && validPersonalCreate() && expenseDayInWindow(u)
          : base == 'personalExpenseDays' ? personalOn(u) && validPersonalDay(u, docId)
          : true));
    }

    // A closed cash day stays closed for everyone, owners too (#38): a queued or
    // stale write must not reopen it. There is no reopen action.
    function cashStaysClosed() {
      return resource.data.get('signedOut', false) != true
        || request.resource.data.get('signedOut', false) == true;
    }

    function canUpdateRecord(base, u, docId) {
      return base in billCollections() ? canUpdateBill(u, base, docId)
        : base in ['cashManagement', 'cashSessions'] && !cashStaysClosed() ? false
        : base == 'autoSaves' ? ownAutoSaveWrite(docId)
        : base == 'drafts' ? draftUpdateOk()
        : base == 'notifications' ? notificationReadOnly()
        : base == 'expenses' && personalTagged(request.resource.data) && !personalTagged(resource.data) ? false
        : base in ['expenses', 'personalExpenses'] && !expenseFieldsOk(request.resource.data) ? false
        : isOwnerIn(u) ? true
        : base == 'expenses' ? canUpdateExpense(u)
        : base == 'personalExpenses' ? personalOn(u) && canUpdateExpense(u)
          && request.resource.data.get('category', null) == 'personal'
          && request.resource.data.get('day', null) == resource.data.get('day', null)
        : base == 'personalExpenseDays' ? personalOn(u) && validPersonalDay(u, docId)
        : base in ['withdrawals', 'stockAdjustments']
          ? (legacyBackfillOnly()
             || (isManagerIn(u)
                 && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']) || amountOk())))
        : base == 'cashManagement' ? (cashAppendOk() || cashCloseOk() || cashLateCountOk())
        : base == 'cashSessions' ? false
        // settings/app is guarded in the match (appSettingsGuard / managerShopSettingsOk); other docs owner only
        : base == 'settings' ? docId == 'app'
        : base == 'items' ? isManagerIn(u) && itemFieldsOk(request.resource.data.diff(resource.data).affectedKeys())
        : base == 'counters' ? counterIncrementOk()
        : base == 'itemFrequency' ? itemFrequencyOk(docId)
        : true;
    }

    function canDeleteRecord(base, u, docId) {
      return base in billCollections() ? canDeleteBill(u)
        : base in ['autoSaves', 'drafts', 'notifications'] ? canDeleteOwnRecord(base, u, docId)
        : isOwnerIn(u) ? true
        : base == 'expenses' ? canDeleteExpense(u)
        : base == 'personalExpenses' ? personalOn(u) && canDeleteExpense(u)
        : base == 'personalExpenseDays' ? false
        : base in ['withdrawals', 'stockAdjustments'] ? isManagerIn(u)
        : base in ['cashManagement', 'cashSessions', 'items', 'counters', 'settings', 'itemFrequency'] ? false
        : true;
    }

    // settings/app (minClientVersion) can lock every outdated phone out: owner only.
    function appSettingsGuard(collection, docId) {
      return !(docId == 'app' && collection in ['settings', 'dev_settings'])
        || isOwnerIn(collection == 'settings' ? 'users' : 'dev_users');
    }

    // Settings › Aadhat: a manager may update only these settings/app fields, and
    // only when Roles & access allows it (roleAccess.manager.shopSettings == true).
    function shopSettingsFields() {
      return ['laborRate', 'heavyWeightThreshold', 'labourPackageKg', 'labourUpdatedAt', 'labourUpdatedBy',
              'checkThresholds', 'checksUpdatedAt', 'checksUpdatedBy',
              'businessName', 'businessDetails', 'businessUpdatedAt', 'businessUpdatedBy'];
    }

    function managerShopSettingsOk(collection, docId) {
      let access = resource.data.get('roleAccess', {});
      return docId == 'app' && collection in ['settings', 'dev_settings']
        && isManagerIn(usersOf(collection))
        && access is map && access.get('manager', {}) is map
        && access.get('manager', {}).get('shopSettings', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(shopSettingsFields());
    }

    // Stock records: writes must come from an app version that maintains the stock
    // checkpoint (sets clientVersion >= 3). Blocks outdated apps from creating or
    // overwriting bills/adjustments. DEPLOY ONLY AFTER every phone runs the new app.
    function stockCollections() {
      return ['purchases', 'retailSales', 'wholesaleSales', 'stockAdjustments',
              'dev_purchases', 'dev_retailSales', 'dev_wholesaleSales', 'dev_stockAdjustments'];
    }

    // The clientVersion gate is switched on by the owner (settings/app.enforceClientVersion
    // = true, dev_settings/app for dev_) once every phone runs the new app, so these rules
    // can be deployed before the old APK is retired.
    function clientGateOn(collection) {
      let settingsPath = /databases/$(database)/documents/$(collection.matches('dev_.*') ? 'dev_settings' : 'settings')/app;
      return exists(settingsPath) && get(settingsPath).data.get('enforceClientVersion', false) == true;
    }

    function writesCurrentClient(collection) {
      return !clientGateOn(collection) || request.resource.data.get('clientVersion', 0) >= 3;
    }

    function businessAccess(collection) {
      return (collection in businessCollections() && isApproved())
        || (collection in devBusinessCollections() && isApprovedIn('dev_users'));
    }

    // --- reads (#57, #18; docs/role-permissions.md "Server-side read rules") ---
    // Called after businessAccess, so the caller's profile is already read. The
    // owner reads everything (backup, Admin). `single` = a get of one document.
    function canReadRecord(base, u, docId, single) {
      return isOwnerIn(u)
        || (base in ['notifications', 'drafts']
            ? (single && resource == null) || resource.data.get('userId', null) == request.auth.uid
          : base == 'autoSaves' ? docId == request.auth.uid
          : base == 'settings' ? single && docId == 'app'
          : base == 'withdrawals' ? roleSeesMoneyPages(u)
          : base == 'personalExpenses' ? personalOn(u)
          : base == 'cashSessions' ? isManagerIn(u)
          : true);
    }

    // Withdrawals are shown only on Money, Statements and Insights (roleAccess ids
    // finance, reports, analytics; defaults: on for managers, off for members). A
    // manager or member reads them only when one of those is on for their role: one
    // extra read (settings/app), never for the owner.
    function roleSeesMoneyPages(usersCol) {
      let role = get(profilePath(usersCol)).data.get('role', '');
      let def = role == 'manager';
      let p = settingsAppPath(usersCol);
      let access = exists(p) ? get(p).data.get('roleAccess', {}) : {};
      let r = access is map ? access.get(role, {}) : {};
      let a = r is map ? r : {};
      return a.get('finance', def) == true || a.get('reports', def) == true || a.get('analytics', def) == true;
    }

    // --- stock checkpoint (stockCheckpoints/current) ---

    function isManagerIn(usersCol) {
      return isApprovedIn(usersCol) && get(profilePath(usersCol)).data.get('role', '') in ['owner', 'manager'];
    }

    // Fields any approved user may write to mark the checkpoint stale.
    function staleMarkOnly() {
      return request.resource.data.get('stale', false) == true
        && (resource == null
            ? request.resource.data.keys().hasOnly(['stale', 'staleCount', 'staleAt', 'staleReason', 'staleBy'])
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['stale', 'staleCount', 'staleAt', 'staleReason', 'staleBy']));
    }

    // Only the two docs the app uses (firestore-service.js checkpointRef / legacyScanRef).
    function checkpointRules(usersCol, docId) {
      return docId == 'current'
        ? (isManagerIn(usersCol) || (isApprovedIn(usersCol) && staleMarkOnly()))
        : docId == 'legacyScan' && isManagerIn(usersCol);
    }

    // --- item rate/name history (rateHistory, #82 / #65 phase 1) ---
    // Append-only: owner/manager create entries for their own uid; nobody
    // updates or deletes them. `index` = position in the rate list (#65);
    // `source` = where the change was made (Items page row, edit dialog, Excel import).
    function validRateHistoryEntry(usersCol) {
      let d = request.resource.data;
      return isManagerIn(usersCol)
        && d.keys().hasOnly(['itemId', 'itemName', 'field', 'old', 'new', 'by', 'byUserId', 'at', 'source', 'flags', 'index'])
        && d.keys().hasAll(['itemId', 'field', 'byUserId', 'at'])
        && d.itemId is string && d.itemId.size() > 0
        && d.field in ['purchase', 'wholesale', 'retail', 'name', 'hindiName']
        && d.byUserId == request.auth.uid
        && d.at is number
        && (!('source' in d) || d.source in ['modal', 'inline', 'import'])
        && (!('index' in d) || (d.index is int && d.index >= 0 && d.index <= 20));
    }

    // --- user profile rules (shared by users and dev_users) ---

    function canReadProfile(usersCol, userId) {
      // Own profile (pending/rejected users too, at login); owner and managers read
      // everyone (Admin, Roles & access, App health). Members never read others (#57).
      return (isSignedIn() && request.auth.uid == userId) || isManagerIn(usersCol);
    }

    function canCreateProfile(userId) {
      // Self-registration only, and always as a pending staff member.
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('role', '') == 'staff'
        && !('rentRole' in request.resource.data);
    }

    // An owner can't change their own role/status, nor demote or remove another
    // owner (two owners removing each other at once would leave none).
    function ownerProfileGuardOk(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])
        || (request.auth.uid != userId && resource.data.get('role', '') != 'owner');
    }

    function canUpdateProfile(usersCol, userId) {
      return (isOwnerIn(usersCol) && ownerProfileGuardOk(userId))
        || (isSignedIn()
            && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'status', 'approvedAt', 'approvedBy', 'rentRole']));
    }

    // --- audit logs (#55) and telemetry (#122): append-only ---

    // The caller's own uid; `serverTime` (FieldValue.serverTimestamp) is the
    // trusted time. `timestamp` (client clock, used for ordering) may not be in
    // the future and only lags when the entry was queued offline (up to 3 days);
    // entries without serverTime (older apps) must be within 10 minutes.
    function validAuditEntry() {
      let d = request.resource.data;
      let now = request.time.toMillis();
      return d.keys().hasOnly(['action', 'userId', 'userName', 'userRole', 'details', 'timestamp', 'date', 'serverTime'])
        && d.get('userId', null) == request.auth.uid
        && d.get('action', null) is string && d.action.size() <= 64
        && d.get('timestamp', null) is number
        && d.timestamp <= now + 600000
        && (d.get('serverTime', null) == request.time
            ? d.timestamp >= now - 259200000
            : (!('serverTime' in d) && d.timestamp >= now - 600000))
        && (!('userName' in d) || (d.userName is string && d.userName.size() <= 200))
        && (!('userRole' in d) || (d.userRole is string && d.userRole.size() <= 32))
        && (!('details' in d) || (d.details is map && d.details.size() <= 40));
    }

    // Owner cleanup (audit.js cleanupOldLogs): only entries older than 90 days.
    function isExpiredAuditEntry() {
      return resource.data.get('timestamp', null) is number
        && resource.data.timestamp < request.time.toMillis() - 7776000000;
    }

    function shortStringOrAbsent(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // One document per sync of a grouped error (telemetry.js syncToFirestore).
    function validTelemetryEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'message', 'source', 'line', 'column', 'stack', 'context', 'timestamp',
                               'date', 'url', 'userAgent', 'userId', 'userName', 'userRole', 'fingerprint',
                               'count', 'occurrences', 'lastSeen', 'firstSeen'])
        && d.get('userId', null) == request.auth.uid
        && d.get('fingerprint', null) is string && d.fingerprint.size() <= 40
        && d.get('count', null) is int && d.count >= 1 && d.count <= 100
        && (!('occurrences' in d) || (d.occurrences is list && d.occurrences.size() <= 10))
        && shortStringOrAbsent(d, 'type', 40)
        && shortStringOrAbsent(d, 'message', 1000)
        && shortStringOrAbsent(d, 'source', 500)
        && shortStringOrAbsent(d, 'stack', 4000)
        && shortStringOrAbsent(d, 'context', 2000)
        && shortStringOrAbsent(d, 'date', 40)
        && shortStringOrAbsent(d, 'url', 500)
        && shortStringOrAbsent(d, 'userAgent', 500)
        && shortStringOrAbsent(d, 'userName', 200)
        && shortStringOrAbsent(d, 'userRole', 32);
    }

    // ============================================
    // RENTALS (#170): rent_* collections (dev_rent_* in development), roles
    // per business (#149). The shop owner owns every business; anyone else
    // needs users/{uid}.rentRole = 'manager' | 'member' (set by the owner).
    // A shop role alone gives no rentals access, and a rentals role alone
    // (shop role 'none') gives no shop access. See docs/rentals-design.md.
    // ============================================

    function rentProfile(usersCol) {
      return get(profilePath(usersCol)).data;
    }

    // 'owner' | 'manager' | 'member' | '' (no access). The profile is read once
    // (rules have an expression budget per request).
    function rentRoleIn(usersCol) {
      return isSignedIn() && exists(profilePath(usersCol)) ? rentRoleOf(get(profilePath(usersCol)).data) : '';
    }

    function rentRoleOf(p) {
      return p.get('status', '') in ['pending', 'rejected'] ? ''
        : p.get('role', '') == 'owner' ? 'owner'
        : p.get('rentRole', '') in ['manager', 'member'] ? p.rentRole
        : '';
    }

    // Owner decision (2026-10-25): anyone with a rentals role records payments
    // and keeps the records up to date. Deletes and Access stay owner-only;
    // correcting a charge's amount stays owner/manager.
    function canWriteRent(usersCol) {
      return rentRoleIn(usersCol) != '';
    }

    function canManageRent(usersCol) {
      return rentRoleIn(usersCol) in ['owner', 'manager'];
    }

    function rentPrefix(usersCol) {
      return usersCol == 'dev_users' ? 'dev_' : '';
    }

    function rentPath(usersCol, coll, id) {
      return /databases/$(database)/documents/$(rentPrefix(usersCol) + coll)/$(id);
    }

    function rentLeasePath(usersCol, leaseId) {
      return rentPath(usersCol, 'rent_leases', leaseId);
    }

    function rentChargePath(usersCol, leaseId, month) {
      return rentPath(usersCol, 'rent_charges', leaseId + '_' + month);
    }

    function rentStr(d, key, min, max) {
      return d.get(key, '') is string && d.get(key, '').size() >= min && d.get(key, '').size() <= max;
    }

    function rentMonth(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function rentMoney(d, key) {
      return d.get(key, null) is number && d.get(key, 0) >= 0;
    }

    function rentNumOrNull(d, key) {
      return d.get(key, null) == null || (d.get(key, null) is number && d.get(key, 0) >= 0);
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // The month after 'YYYY-MM'.
    function nextMonth(m) {
      return int(m[5:7]) == 12 ? string(int(m[0:4]) + 1) + '-01' : m[0:5] + pad2(int(m[5:7]) + 1);
    }

    // This month in India (IST = UTC+5:30), as 'YYYY-MM'.
    function rentThisMonth() {
      let ist = request.time + duration.value(330, 'm');
      return string(ist.year()) + '-' + pad2(ist.month());
    }

    // Every rentals write names its writer (audit: who recorded what).
    function rentWriterOk() {
      return request.resource.data.get('updatedBy', null) == request.auth.uid;
    }

    // Who/when created a record never changes.
    function rentCreationKept() {
      return request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }

    function rentMeta() {
      return ['archived', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }

    // Shape of properties, units, tenants and leases.
    function validRentDoc(base) {
      let d = request.resource.data;
      return d.get('archived', false) is bool
        && rentWriterOk()
        && (base == 'rent_properties'
          ? d.keys().hasOnly(['name', 'address', 'kind', 'notes'].concat(rentMeta()))
            && rentStr(d, 'name', 1, 80) && rentStr(d, 'address', 0, 200) && rentStr(d, 'notes', 0, 500)
            && d.get('kind', 'other') in ['house', 'shop', 'flat', 'plot', 'godown', 'other']
          : base == 'rent_units'
          ? d.keys().hasOnly(['propertyId', 'label', 'rent', 'leaseId', 'lastReading', 'meterRate', 'meterCharge',
                              'type', 'area', 'floor'].concat(rentMeta()))
            && rentUnitExtrasOk(d)
            && rentStr(d, 'propertyId', 1, 64) && rentStr(d, 'label', 1, 60) && rentMoney(d, 'rent')
            && (d.get('leaseId', null) == null || rentStr(d, 'leaseId', 1, 64))
            && rentNumOrNull(d, 'lastReading') && rentNumOrNull(d, 'meterRate')
            && (d.get('meterCharge', null) == null || rentStr(d, 'meterCharge', 1, 80))
          : base == 'rent_tenants'
          ? d.keys().hasOnly(['name', 'phone', 'phone2', 'notes'].concat(rentMeta()))
            && rentStr(d, 'name', 1, 80) && rentStr(d, 'phone', 0, 20) && rentStr(d, 'notes', 0, 500)
            && (resource == null || d.get('phone', '') != resource.data.get('phone', '') ? rentMobile(d.get('phone', null)) : true)
            && (d.get('phone2', null) == null || rentMobile(d.phone2))
          : base == 'rent_leases'
          ? d.keys().hasOnly(['unitId', 'propertyId', 'tenantId', 'rent', 'dueDay', 'startMonth', 'endMonth',
                              'deposit', 'status', 'chargedThrough', 'increasePct', 'rentSince', 'shareToken',
                              'startDate', 'proRate', 'firstRent', 'elecMode', 'meterNo', 'fromLeaseId', 'movedTo'].concat(rentMeta()))
            && rentStr(d, 'unitId', 1, 64) && rentStr(d, 'propertyId', 1, 64) && rentStr(d, 'tenantId', 1, 64)
            && rentMoney(d, 'rent') && rentMoney(d, 'deposit')
            && d.get('dueDay', 0) is int && d.dueDay >= 1 && d.dueDay <= 28
            && rentMonth(d.get('startMonth', null))
            && (d.get('endMonth', null) == null || rentMonth(d.endMonth))
            && d.get('status', '') in ['active', 'ended']
            && (d.get('chargedThrough', null) == null || rentMonth(d.chargedThrough))
            && (!('increasePct' in d) || (d.increasePct is number && d.increasePct >= 0 && d.increasePct <= 100))
            && (!('rentSince' in d) || rentMonth(d.rentSince))
            && (d.get('shareToken', null) == null || rentShareToken(d.shareToken))
            && (!('startDate' in d) || (rentDate(d.startDate) && d.startDate[0:7] == d.startMonth))
            && d.get('proRate', false) is bool
            // firstRent <= rent only when the lease is created; afterwards firstRent is fixed
            // and the rent may go down (rentLeaseUpdateOk keeps firstRent unchanged).
            && (d.get('firstRent', null) == null || (d.firstRent is number && d.firstRent >= 0 && (resource != null || d.firstRent <= d.rent)))
            && d.get('elecMode', 'meter') in ['included', 'meter', 'own']
            && (d.get('meterNo', null) == null || rentStr(d, 'meterNo', 1, 40))
            && (d.get('movedTo', null) == null || rentStr(d, 'movedTo', 1, 64))
          : false);
    }

    // 10-digit Indian mobile (WhatsApp reminders), stored without +91.
    function rentMobile(v) {
      return v is string && v.matches('^[6-9][0-9]{9}$');
    }

    function rentDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function rentShareToken(t) {
      return t is string && t.matches('^[A-Za-z0-9_-]{22,64}$');
    }

    // Unit type (flat / commercial / office / godown / other), optional size (sq ft) and floor.
    // Units saved before types existed have no type (shown as flats until set).
    function rentUnitExtrasOk(d) {
      return (!('type' in d) || d.type in ['flat', 'commercial', 'office', 'godown', 'other'])
        && (d.get('area', null) == null || (d.area is number && d.area > 0 && d.area <= 1000000))
        && (d.get('floor', null) == null || rentStr(d, 'floor', 1, 20));
    }

    // New leases start active, with no charges and no tenant link (except one carried over
    // on a change of unit), and take their unit in the same write.
    // The lease's property is its unit's, and its tenant exists. Non-owners can't
    // back-date the start more than 2 days (IST; the app's default edit window, fixed
    // here because Roles & access days would cost reads past this write's limit).
    // A member's pro-rated first month is the computed one (RENT-11).
    function rentLeaseCreateOk(usersCol, docId, owner, mgr) {
      let d = request.resource.data;
      let unit = getAfter(rentPath(usersCol, 'rent_units', d.unitId)).data;
      return d.get('status', '') == 'active' && d.get('endMonth', null) == null
        && d.get('movedTo', null) == null
        // No charges yet, or the first month's charge written in the same batch (move-in).
        && (d.get('chargedThrough', null) == null
            || (d.chargedThrough == d.startMonth && d.startMonth <= rentThisMonth()
                && existsAfter(rentChargePath(usersCol, docId, d.startMonth))))
        && unit.get('leaseId', null) == docId
        && unit.get('propertyId', '') == d.propertyId
        && existsAfter(rentPath(usersCol, 'rent_tenants', d.tenantId))
        && (owner || d.get('startDate', '') >= rentDaysAgo(2))
        && (mgr || d.get('firstRent', null) == null || rentFirstRentOk(d))
        && (d.get('fromLeaseId', null) == null ? d.get('shareToken', null) == null : rentUnitChangeOk(usersCol, docId, d));
    }

    // Change of unit (rent-unit.js): the same tenant's active lease (fromLeaseId)
    // ends in this write on another unit, pointing here (movedTo), with the move
    // month, or the month before when the move is on the 1st (that month isn't
    // charged twice). Its tenant link moves here: only that lease's token, which it
    // gives up in the same write.
    function rentUnitChangeOk(usersCol, docId, d) {
      let before = get(rentLeasePath(usersCol, d.fromLeaseId)).data;
      let old = getAfter(rentLeasePath(usersCol, d.fromLeaseId)).data;
      return rentStr(d, 'fromLeaseId', 1, 64)
        && before.status == 'active'
        && old.status == 'ended' && old.tenantId == d.tenantId && old.unitId != d.unitId
        && old.get('movedTo', null) == docId
        && (old.endMonth == d.startMonth
            || (d.get('startDate', '').matches('^.{8}01$') && nextMonth(old.endMonth) == d.startMonth))
        && (d.get('shareToken', null) == null
            || (before.get('shareToken', null) == d.shareToken && old.get('shareToken', null) == null));
    }

    // The old lease of a change of unit points at the new lease created in the same write.
    function rentMovedOk(usersCol, docId, to) {
      return !exists(rentLeasePath(usersCol, to))
        && getAfter(rentLeasePath(usersCol, to)).data.get('fromLeaseId', null) == docId;
    }

    // 'YYYY-MM-DD' n days ago in India (IST).
    function rentDaysAgo(n) {
      let ist = request.time + duration.value(330, 'm') - duration.value(n, 'd');
      return string(ist.year()) + '-' + pad2(ist.month()) + '-' + pad2(ist.day());
    }

    // Lease changes (review of #10, High):
    //  - an ended lease is final: status, endMonth and chargedThrough never change again;
    //  - an active lease stays active with endMonth null, and chargedThrough moves
    //    forward exactly one month per write, to a month whose charge exists after
    //    the write and that isn't after this month (IST);
    //  - active -> ended only in the move-out write: endMonth (start..this month) =
    //    chargedThrough, its charge exists, the unit is freed in the same write.
    //    Ending before the last charged month deletes the later unpaid months and
    //    is owner/manager only, or one month back on a change of unit (movedTo; a
    //    move on the 1st within the members' 2-day start window).
    function rentLeaseUpdateOk(usersCol, docId, mgr) {
      let d = request.resource.data;
      let r = resource.data;
      let before = r.get('chargedThrough', null);
      let next = d.get('chargedThrough', null);
      let moved = r.status == 'active' && d.get('status', '') == 'ended' && d.get('movedTo', null) != null
        && rentMovedOk(usersCol, docId, d.movedTo);
      return (d.diff(r).affectedKeys().hasOnly(['status', 'endMonth', 'chargedThrough', 'movedTo', 'shareToken', 'updatedAt', 'updatedBy'])
          ? rentLeaseStateOk(d)
          : validRentDoc('rent_leases') && rentCreationKept()
            && d.startMonth == r.startMonth && d.unitId == r.unitId && d.tenantId == r.tenantId
            && d.get('startDate', null) == r.get('startDate', null) && d.get('firstRent', null) == r.get('firstRent', null)
            && d.get('proRate', false) == r.get('proRate', false)
            && d.get('fromLeaseId', null) == r.get('fromLeaseId', null))
        && (d.get('movedTo', null) == r.get('movedTo', null) || moved)
        && (d.get('shareToken', null) == r.get('shareToken', null) || mgr
            || (moved && d.get('shareToken', null) == null
                && getAfter(rentLeasePath(usersCol, d.movedTo)).data.get('shareToken', null) == r.get('shareToken', null)))
        && (r.status == 'ended'
          ? d.status == 'ended' && d.get('endMonth', null) == r.get('endMonth', null) && next == before
          : d.status == 'active'
            ? d.get('endMonth', null) == null
              && (next == before
                  || (next == (before == null ? d.startMonth : nextMonth(before))
                      && next <= rentThisMonth()
                      && existsAfter(rentChargePath(usersCol, docId, next))))
            : rentMonth(d.get('endMonth', null))
              && d.endMonth >= d.startMonth && d.endMonth <= rentThisMonth()
              && next == d.endMonth && before != null
              && existsAfter(rentChargePath(usersCol, docId, next))
              && getAfter(rentPath(usersCol, 'rent_units', d.unitId)).data.get('leaseId', '') == null
              && (next == before
                  || (next < before && (mgr || (moved && nextMonth(next) == before))
                      && !existsAfter(rentChargePath(usersCol, docId, before)))));
    }

    // Only the lease's state changed (charging, move-out, change of unit, link): the
    // other fields are as stored, so only these are checked (expression budget).
    function rentLeaseStateOk(d) {
      return rentWriterOk() && d.get('status', '') in ['active', 'ended']
        && (d.get('endMonth', null) == null || rentMonth(d.endMonth))
        && (d.get('chargedThrough', null) == null || rentMonth(d.chargedThrough))
        && (d.get('movedTo', null) == null || rentStr(d, 'movedTo', 1, 64))
        && (d.get('shareToken', null) == null || rentShareToken(d.shareToken));
    }

    // A unit's lease link changes only with the lease: set by a new active lease
    // for this unit, cleared when that lease ends in the same write.
    function rentUnitLeaseOk(usersCol, docId) {
      let before = resource.data.get('leaseId', null);
      let next = request.resource.data.get('leaseId', null);
      return next == before
        || (before == null && next != null
            && !exists(rentLeasePath(usersCol, next))
            && getAfter(rentLeasePath(usersCol, next)).data.unitId == docId
            && getAfter(rentLeasePath(usersCol, next)).data.status == 'active')
        || (before != null && next == null
            && getAfter(rentLeasePath(usersCol, before)).data.status == 'ended');
    }

    // lastReading / meterRate move only with a meter write on a charge of this
    // unit (meterCharge points at it); owner/manager may also set the rate alone.
    function rentUnitMeterOk(usersCol, docId, mgr) {
      let d = request.resource.data;
      let r = resource.data;
      let meterKeys = d.diff(r).affectedKeys().intersection(['lastReading', 'meterRate', 'meterCharge'].toSet());
      return meterKeys.size() == 0
        || (mgr && meterKeys.hasOnly(['meterRate']))
        || (rentStr(d, 'meterCharge', 1, 80)
            && getAfter(rentPath(usersCol, 'rent_charges', d.meterCharge)).data.unitId == docId
            && getAfter(rentPath(usersCol, 'rent_charges', d.meterCharge)).data.electricity.curr == d.lastReading
            && getAfter(rentPath(usersCol, 'rent_charges', d.meterCharge)).data.electricity.rate == d.meterRate);
    }

    function rentChargeFields() {
      return ['leaseId', 'unitId', 'propertyId', 'tenantId', 'tenantName', 'unitLabel', 'month', 'dueDay',
              'rent', 'electricity', 'amount', 'paid', 'open', 'payments', 'voided', 'createdAt', 'updatedAt', 'updatedBy'];
    }

    // rent_charges/{leaseId}_{YYYY-MM}: created only in the write that moves its
    // active lease's chargedThrough to exactly this month; amount = the lease's
    // rent; nothing paid, no electricity yet.
    function validRentChargeCreate(usersCol, docId) {
      let d = request.resource.data;
      let lease = getAfter(rentLeasePath(usersCol, d.get('leaseId', '-'))).data;
      return d.keys().hasOnly(rentChargeFields())
        && rentWriterOk()
        && rentStr(d, 'leaseId', 1, 64) && rentMonth(d.get('month', null))
        && docId == d.leaseId + '_' + d.month
        && lease.status == 'active'
        && lease.get('chargedThrough', null) == d.month
        && (!exists(rentLeasePath(usersCol, d.leaseId))
            || get(rentLeasePath(usersCol, d.leaseId)).data.get('chargedThrough', null) != d.month)
        && d.get('unitId', '') == lease.unitId && d.get('tenantId', '') == lease.tenantId
        && d.get('propertyId', '') == lease.propertyId && d.get('dueDay', 0) == lease.dueDay
        && d.get('amount', null) == rentMonthRent(lease, d.month) && d.get('rent', null) == rentMonthRent(lease, d.month)
        && d.get('electricity', null) == null
        && d.get('paid', null) == 0 && d.get('payments', null) == [] && !('voided' in d)
        && d.get('open', null) == (lease.rent > 0)
        && rentStr(d, 'tenantName', 0, 80) && rentStr(d, 'unitLabel', 0, 60);
    }

    // The rent of a month: a pro-rated first month (firstRent, set at move-in) or the lease rent (RENT-11).
    function rentMonthRent(lease, month) {
      return month == lease.startMonth && lease.get('firstRent', null) != null ? lease.firstRent : lease.rent;
    }

    // Σ amount of up to 12 payment entries (rules have no loops; a charge holds at most 12).
    function rentPayAt(list, i) {
      return list.size() > i ? list[i].amount : 0;
    }

    function rentPaidSum(list) {
      return rentPayAt(list, 0) + rentPayAt(list, 1) + rentPayAt(list, 2) + rentPayAt(list, 3)
        + rentPayAt(list, 4) + rentPayAt(list, 5) + rentPayAt(list, 6) + rentPayAt(list, 7)
        + rentPayAt(list, 8) + rentPayAt(list, 9) + rentPayAt(list, 10) + rentPayAt(list, 11);
    }

    // One new payment entry by the caller (amount > 0, known mode), at most 12 per charge.
    // An entry with a receipt number (rno) needs its receipt rent_receipts/{charge}_{i}
    // with that number created in the same write (validRentReceiptCreate).
    function rentNewEntryOk(usersCol, docId) {
      let list = request.resource.data.payments;
      let n = resource.data.get('payments', []).size();
      return appendsOneEntry('payments') && n < 12
        && list[n].keys().hasOnly(['amount', 'mode', 'ref', 'date', 'at', 'by', 'byName', 'rno'])
        && list[n].amount > 0
        && list[n].get('by', null) == request.auth.uid
        && list[n].get('mode', '') in ['cash', 'upi', 'bank', 'cheque']
        && (!('rno' in list[n])
            || getAfter(rentPath(usersCol, 'rent_receipts', docId + '_' + string(n))).data.get('no', '') == list[n].rno);
    }

    // A payment (rent-store.js recordPayment): paid grows by exactly the new
    // entry and never above the amount due.
    function rentPaymentOk(usersCol, docId) {
      let d = request.resource.data;
      let r = resource.data;
      let n = r.get('payments', []).size();
      return d.diff(r).affectedKeys().hasOnly(['payments', 'paid', 'open', 'updatedAt', 'updatedBy'])
        && rentWriterOk()
        && rentNewEntryOk(usersCol, docId)
        && d.get('paid', null) is number
        && d.paid >= r.paid + d.payments[n].amount - 0.01
        && d.paid <= r.paid + d.payments[n].amount + 0.01
        && d.paid <= r.amount + 0.01
        && d.get('open', null) == (d.paid < r.amount - 0.001);
    }

    // Electricity from a sub-meter (rent-store.js recordMeter): units = current −
    // previous, amount = units × rate, charge = rent + electricity (rent unchanged).
    // Previous = the reading already on this charge, else the unit's last reading;
    // rate = the unit's rate unless owner/manager; replacing a saved reading is
    // owner/manager only; the unit stores the new reading in the same write.
    function rentMeterOk(usersCol, docId, mgr) {
      let d = request.resource.data;
      let r = resource.data;
      let e = d.get('electricity', null);
      let old = r.get('electricity', null);
      let unit = get(rentPath(usersCol, 'rent_units', r.unitId)).data;
      let leaseMode = get(rentLeasePath(usersCol, r.leaseId)).data.get('elecMode', 'meter');
      let unitAfter = getAfter(rentPath(usersCol, 'rent_units', r.unitId)).data;
      return d.diff(r).affectedKeys().hasOnly(['electricity', 'amount', 'open', 'updatedAt', 'updatedBy'])
        && rentWriterOk()
        && leaseMode == 'meter'
        && e is map && e.keys().hasOnly(['prev', 'curr', 'rate', 'units', 'amount'])
        && e.get('prev', null) is number && e.get('curr', null) is number && e.get('rate', null) is number
        && e.get('units', null) is number && e.get('amount', null) is number
        && e.prev >= 0 && e.curr >= e.prev && e.rate >= 0
        && (old == null || mgr)
        && (old != null ? e.prev == old.prev : (unit.get('lastReading', null) == null || e.prev == unit.lastReading))
        && (mgr || unit.get('meterRate', null) == null || e.rate == unit.meterRate)
        && unitAfter.get('meterCharge', null) == docId
        && unitAfter.get('lastReading', null) == e.curr && unitAfter.get('meterRate', null) == e.rate
        && e.units >= e.curr - e.prev - 0.01 && e.units <= e.curr - e.prev + 0.01
        && e.amount >= e.units * e.rate - 0.01 && e.amount <= e.units * e.rate + 0.01
        && d.get('amount', null) is number
        && d.amount >= r.rent + e.amount - 0.01 && d.amount <= r.rent + e.amount + 0.01
        && d.amount >= r.paid - 0.01
        && d.get('open', null) == (r.paid < d.amount - 0.001);
    }

    // Owner/manager corrections (e.g. a waived month): same lease, month and
    // creation; payments unchanged or one new own entry; paid = Σ entries ≤ amount.
    function rentChargeEditOk(usersCol, docId) {
      let d = request.resource.data;
      let r = resource.data;
      return d.keys().hasOnly(rentChargeFields())
        && rentWriterOk() && rentCreationKept()
        && d.get('leaseId', null) == r.leaseId && d.get('month', null) == r.month
        && d.get('unitId', null) == r.unitId && d.get('tenantId', null) == r.tenantId
        && d.get('electricity', null) == r.get('electricity', null) && d.get('rent', null) == r.get('rent', null)
        && d.get('voided', []) == r.get('voided', [])
        && rentMoney(d, 'amount') && rentMoney(d, 'paid')
        && d.get('payments', null) is list
        && (d.payments == r.get('payments', []) || rentNewEntryOk(usersCol, docId))
        && d.payments.size() <= 12
        && rentPaidMatches(d.paid, rentPaidSum(d.payments))
        && d.paid <= d.amount + 0.01
        && d.get('open', null) == (d.paid < d.amount - 0.001);
    }

    function rentPaidMatches(paid, sum) {
      return paid >= sum - 0.01 && paid <= sum + 0.01;
    }

    // Change of unit, pro-rated (RENT-13): in the write that ends the lease with a
    // move (movedTo), its last month's rent goes down to the old unit's days; the
    // amount follows (rent + electricity), never below what is paid. Members: the
    // computed value, or (more paid than that) closed at what is paid; owner/manager:
    // any lower amount (they correct charges anyway).
    function rentChargeMoveOk(usersCol, mgr) {
      let d = request.resource.data;
      let r = resource.data;
      return d.get('rent', null) != r.get('rent', null)
        && rentChargeMovedOk(usersCol, mgr, d, r, getAfter(rentLeasePath(usersCol, r.leaseId)).data);
    }

    function rentChargeMovedOk(usersCol, mgr, d, r, lease) {
      let e = r.get('electricity', null) == null ? 0 : r.electricity.amount;
      return d.diff(r).affectedKeys().hasOnly(['rent', 'amount', 'open', 'updatedAt', 'updatedBy'])
        && rentWriterOk()
        && lease.status == 'ended' && lease.get('movedTo', null) != null && lease.endMonth == r.month
        && get(rentLeasePath(usersCol, r.leaseId)).data.status == 'active'
        && d.get('rent', null) is number && d.rent >= 0 && d.rent <= r.rent
        && (mgr || rentMoveRentOk(d.rent, r.rent, lease, r.month,
              getAfter(rentLeasePath(usersCol, lease.movedTo)).data.get('startDate', ''),
              d.get('amount', 0) >= r.paid - 0.01 && d.get('amount', 0) <= r.paid + 0.01 && d.get('open', true) == false))
        && d.get('amount', null) is number
        && d.amount >= d.rent + e - 0.01 && d.amount <= d.rent + e + 0.01
        && d.amount >= r.paid - 0.01
        && d.get('open', null) == (r.paid < d.amount - 0.001);
    }

    // RENT-11: rent × days from the start date to the month's end ÷ days in that month, rounded.
    function rentFirstRentOk(d) {
      let days = rentMonthDays(d.startMonth);
      let x = float(d.rent) * (days - int(d.startDate[8:10]) + 1) / days;
      return d.firstRent >= x - 0.5 && d.firstRent <= x + 0.5;
    }

    // RENT-13: rent × (days in the old unit: from the 1st, or the lease's start day when
    // that month was pro-rated, to the day before the move) ÷ (days that charge covers),
    // rounded to the rupee (either way on a .5).
    // capped: closed at what is paid (more than the share): any rent from the share up.
    function rentMoveRentOk(v, full, lease, month, date, capped) {
      let s = month == lease.startMonth && lease.get('firstRent', null) != null ? int(lease.startDate[8:10]) : 1;
      let x = float(full) * (int(date[8:10]) - s) / (rentMonthDays(month) - s + 1);
      return rentDate(date) && date[0:7] == month && v >= x - 0.5 && (capped || (v is int && v <= x + 0.5));
    }

    function rentMonthDays(m) {
      let y = int(m[0:4]);
      let mo = int(m[5:7]);
      return mo == 2 ? (y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) ? 29 : 28) : (mo in [4, 6, 9, 11] ? 30 : 31);
    }

    // This year in India (IST = UTC+5:30): receipt numbers follow the server's clock.
    function rentIstYear() {
      return (request.time + duration.value(330, 'm')).year();
    }

    // Receipt issued later (rent-store.js issueReceipt): entry i gains its rno and
    // nothing else changes; i comes from this year's receipt counter, which must
    // point at rent_receipts/{charge}_{i} created in the same write with that number.
    function rentChargeRnoOk(usersCol, docId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payments', 'updatedAt', 'updatedBy'])
        && rentWriterOk()
        && rentRnoIdx(usersCol, docId, resource.data.get('payments', []), request.resource.data.get('payments', []),
             getAfter(rentCounterPath(usersCol, rentIstYear())).data.get('rid', ''));
    }

    function rentRnoIdx(usersCol, docId, a, b, rid) {
      return b is list && b.size() == a.size()
        && rid.size() > docId.size() + 1 && rid[0:docId.size() + 1] == docId + '_'
        && rentRnoAt(usersCol, a, b, rid, int(rid[docId.size() + 1:rid.size()]));
    }

    function rentRnoAt(usersCol, a, b, rid, i) {
      return i >= 0 && i < a.size() && !('rno' in a[i]) && b[i].diff(a[i]).affectedKeys().hasOnly(['rno'])
        && b.removeAll([b[i]]) == a.removeAll([a[i]])
        && getAfter(rentPath(usersCol, 'rent_receipts', rid)).data.get('no', '') == b[i].rno;
    }

    // Cancelling a receipt (rent-store.js voidReceipt), owner/manager: the charge
    // lists that payment's index in `voided` (so the tenant link drops its number)
    // in the same write that marks rent_receipts/{charge}_{i} void.
    function rentChargeVoidOk(usersCol, docId) {
      let d = request.resource.data;
      let r = resource.data;
      let old = r.get('voided', []);
      let v = d.get('voided', []);
      return d.diff(r).affectedKeys().hasOnly(['voided', 'updatedAt', 'updatedBy'])
        && rentWriterOk()
        && v is list && v.size() == old.size() + 1 && v.size() <= 12 && v.hasAll(old)
        && v[v.size() - 1] is int && !(v[v.size() - 1] in old)
        && v[v.size() - 1] >= 0 && v[v.size() - 1] < r.get('payments', []).size()
        && getAfter(rentPath(usersCol, 'rent_receipts', docId + '_' + string(v[v.size() - 1]))).data.get('void', false) == true;
    }

    // ---- Rent receipts (RENT-12): plain, non-GST, one per payment ----
    // rent_receipts/{chargeId}_{i} is created in the payment write that adds entry i
    // (with rno = its number) to the charge, or later for an entry i without one
    // (rentChargeRnoOk), and moves this IST year's counter rent_counters/receipts_{YYYY}
    // on by exactly one; the number is that counter value, so numbers are unique and
    // gap-free per year. The header (business name, address) is not stored: the app
    // shows it from Settings. Never edited, except cancel (void) by owner/manager.
    function rentReceiptFields() {
      return ['no', 'year', 'seq', 'chargeId', 'pi', 'leaseId', 'tenantId', 'unitId', 'propertyId', 'tenantName',
              'place', 'ut', 'months', 'rent', 'elec', 'total', 'paid', 'mode', 'ref', 'date', 'balance', 'by',
              'byName', 'issuedBy', 'createdAt', 'void', 'voidBy', 'voidByName', 'voidAt', 'voidReason'];
    }

    function rentCounterPath(usersCol, year) {
      return rentPath(usersCol, 'rent_counters', 'receipts_' + string(year));
    }

    // The counter moves from seq − 1 (or nothing, for the year's first receipt) to seq, pointing at this receipt.
    function rentReceiptSeqOk(usersCol, rid, year, seq) {
      let path = rentCounterPath(usersCol, year);
      return getAfter(path).data.get('last', 0) == seq && getAfter(path).data.get('rid', '') == rid
        && (exists(path) ? get(path).data.get('last', 0) == seq - 1 : seq == 1);
    }

    // "Received by" is the caller's profile name (users/{uid}.name, cut to 80; the app says 'User' when it is empty).
    function rentByNameOk(usersCol, v) {
      let nm = rentProfile(usersCol).get('name', '');
      return v == (nm == '' ? 'User' : nm.size() > 80 ? nm[0:80] : nm);
    }

    // Balance due = the charge's after this write (a receipt issued later shows it as then).
    function rentBalanceOk(d, amount, paid) {
      return d.get('balance', null) is number && d.balance >= amount - paid - 0.01 && d.balance <= amount - paid + 0.01;
    }

    // With the payment: entry pi is new and the caller's.
    function rentReceiptWithPayment(usersCol, d, ch, before) {
      return before.size() == d.pi && ch.payments.size() == d.pi + 1
        && d.get('by', '') == request.auth.uid && rentByNameOk(usersCol, d.get('byName', ''))
        && !('issuedBy' in d);
    }

    // Later: entry pi existed without a number (its writer, or an owner/manager: see the match).
    function rentReceiptLater(d, ch, before) {
      return before.size() == ch.payments.size() && !('rno' in before[d.pi])
        && d.get('issuedBy', '') == request.auth.uid;
    }

    function validRentReceiptCreate(usersCol, rid) {
      let chPath = rentPath(usersCol, 'rent_charges', request.resource.data.get('chargeId', '-'));
      return rentReceiptCreateOk(usersCol, rid, request.resource.data, getAfter(chPath).data,
        get(chPath).data.get('payments', []));
    }

    function rentReceiptCreateOk(usersCol, rid, d, ch, before) {
      return d.keys().hasOnly(rentReceiptFields())
        && !d.keys().hasAny(['voidBy', 'voidByName', 'voidAt', 'voidReason']) && d.get('void', null) == false
        && rentStr(d, 'chargeId', 1, 80) && d.get('pi', -1) is int && d.pi >= 0 && d.pi < 12
        && rid == d.chargeId + '_' + string(d.pi)
        && d.get('year', 0) is int && d.year == rentIstYear()
        && d.get('seq', 0) is int && d.seq >= 1
        && d.get('no', '') is string && d.no.matches('R-' + string(d.year) + '-0*' + string(d.seq))
        && rentReceiptSeqOk(usersCol, rid, d.year, d.seq)
        && d.pi < ch.payments.size()
        && (rentReceiptWithPayment(usersCol, d, ch, before) || rentReceiptLater(d, ch, before))
        && rentBalanceOk(d, ch.amount, ch.paid)
        && rentReceiptMatches(d, ch, ch.payments[d.pi]);
    }

    // The receipt shows payment entry e and its charge exactly; createdAt is the server's time.
    function rentReceiptMatches(d, ch, e) {
      return e.get('rno', '') == d.no && e.get('by', '') == d.get('by', '') && e.get('byName', '') == d.get('byName', '')
        && e.amount == d.get('paid', -1) && e.mode == d.get('mode', '') && e.date == d.get('date', '')
        && e.get('ref', '') == d.get('ref', '')
        && d.get('leaseId', '') == ch.leaseId && d.get('tenantId', '') == ch.tenantId
        && d.get('unitId', '') == ch.unitId && d.get('propertyId', '') == ch.propertyId
        && d.get('months', null) == [ch.month]
        && d.get('rent', null) == ch.rent && d.get('elec', null) == ch.get('electricity', null)
        && d.get('total', null) == ch.amount
        && d.get('tenantName', null) == ch.get('tenantName', '')
        && rentStr(d, 'place', 0, 150) && rentStr(d, 'byName', 0, 80)
        && (!('ut' in d) || d.ut in ['flat', 'commercial', 'office', 'godown', 'other'])
        && d.get('createdAt', null) == request.time;
    }

    // Cancel: void once, by owner/manager, nothing else changes; the charge marks it in the same write.
    function rentReceiptVoidOk(usersCol) {
      let d = request.resource.data;
      let r = resource.data;
      let chPath = rentPath(usersCol, 'rent_charges', r.chargeId);
      return r.get('void', false) == false && d.get('void', null) == true
        && d.diff(r).affectedKeys().hasOnly(['void', 'voidBy', 'voidByName', 'voidAt', 'voidReason'])
        && d.get('voidBy', null) == request.auth.uid && d.get('voidAt', null) is number
        && rentStr(d, 'voidByName', 0, 80) && rentStr(d, 'voidReason', 1, 200)
        && (!existsAfter(chPath) || r.pi in getAfter(chPath).data.get('voided', []));
    }

    function validRentCounter(usersCol, id) {
      let d = request.resource.data;
      let rcpt = getAfter(rentPath(usersCol, 'rent_receipts', d.get('rid', '-'))).data;
      return id.matches('^receipts_[0-9]{4}$')
        && d.keys().hasOnly(['last', 'rid', 'updatedAt', 'updatedBy']) && rentWriterOk()
        && d.get('last', 0) is int && d.last == (resource == null ? 1 : resource.data.last + 1)
        && rentStr(d, 'rid', 1, 90)
        && !exists(rentPath(usersCol, 'rent_receipts', d.rid))
        && rcpt.seq == d.last && id == 'receipts_' + string(rcpt.year);
    }

    // Move-out removes unpaid months after the last month, only inside the
    // move-out write (lease active before, ended after); owner/manager, or the one
    // month after on a change of unit (rentLeaseUpdateOk checks movedTo).
    function rentChargeDeleteOk(usersCol, role) {
      let leaseBefore = get(rentLeasePath(usersCol, resource.data.leaseId)).data;
      let leaseAfter = getAfter(rentLeasePath(usersCol, resource.data.leaseId)).data;
      return (role in ['owner', 'manager']
          || (role == 'member' && leaseAfter.get('movedTo', null) != null && resource.data.month == nextMonth(leaseAfter.endMonth)))
        && resource.data.get('paid', 0) == 0 && resource.data.get('payments', []).size() == 0
        && leaseBefore.status == 'active' && leaseAfter.status == 'ended'
        && resource.data.month > leaseAfter.endMonth;
    }

    function rentCreateOk(base, usersCol, docId) {
      let role = rentRoleIn(usersCol);
      return role != ''
        && (base == 'rent_charges' ? validRentChargeCreate(usersCol, docId)
          : base == 'rent_leases' ? validRentDoc(base) && rentLeaseCreateOk(usersCol, docId, role == 'owner', role in ['owner', 'manager'])
          : base == 'rent_units' ? validRentDoc(base) && rentUnitCreateLeaseOk(usersCol, docId)
            && request.resource.data.get('type', '') in ['flat', 'commercial', 'office', 'godown', 'other']
            && request.resource.data.get('meterCharge', null) == null
          : validRentDoc(base));
    }

    // The caller's rentals role is read once per rule (rules have an expression budget).
    // A new unit is vacant, or occupied by a lease created in the same batch
    // (Add unit with its tenant). An opening meter reading is allowed.
    function rentUnitCreateLeaseOk(usersCol, docId) {
      let l = request.resource.data.get('leaseId', null);
      return l == null
        || (rentStr(request.resource.data, 'leaseId', 1, 64)
            && !exists(rentLeasePath(usersCol, l))
            && getAfter(rentLeasePath(usersCol, l)).data.unitId == docId
            && getAfter(rentLeasePath(usersCol, l)).data.status == 'active');
    }

    function rentUpdateOk(base, usersCol, docId) {
      let role = rentRoleIn(usersCol);
      let mgr = role in ['owner', 'manager'];
      return role != '' && rentUpdateAs(base, usersCol, docId, mgr);
    }

    function rentUpdateAs(base, usersCol, docId, mgr) {
      return base == 'rent_charges'
          ? (rentCreationKept() && (rentPaymentOk(usersCol, docId) || rentChargeRnoOk(usersCol, docId) || rentMeterOk(usersCol, docId, mgr)
              || rentChargeMoveOk(usersCol, mgr)))
            || (mgr && (rentChargeEditOk(usersCol, docId) || rentChargeVoidOk(usersCol, docId)))
        : base == 'rent_leases'
          ? rentLeaseUpdateOk(usersCol, docId, mgr)
        : base == 'rent_units'
          ? (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaseId', 'updatedAt', 'updatedBy'])
              ? rentWriterOk() && rentUnitLeaseOk(usersCol, docId)
              : validRentDoc(base) && rentCreationKept()
                && rentUnitLeaseOk(usersCol, docId) && rentUnitMeterOk(usersCol, docId, mgr))
        : validRentDoc(base) && rentCreationKept();
    }

    function rentDeleteOk(base, usersCol) {
      return isOwnerIn(usersCol)
        || (base == 'rent_charges' && resource != null && rentChargeDeleteOk(usersCol, rentRoleIn(usersCol)));
    }

    // Tenant rent-history link (follow-up to #170): rent_public/{token} is a
    // read-only snapshot anyone holding the exact token may get (no list). Written
    // only by rentals roles while the lease points at this token (same write as
    // the lease change, via getAfter); removed when the link is turned off/replaced.
    function validRentPublic(usersCol, token) {
      let d = request.resource.data;
      return rentRoleIn(usersCol) != ''
        && rentShareToken(token)
        && d.keys().hasOnly(['lid', 'v', 'shop', 'tenant', 'place', 'ut', 'since', 'em', 'rent', 'dueDay', 'ended', 'endMonth', 'months', 'updatedAt'])
        && (!('since' in d) || rentDate(d.since))
        && (!('em' in d) || d.em in ['included', 'meter', 'own'])
        && (!('ut' in d) || d.ut in ['flat', 'commercial', 'office', 'godown', 'other'])
        && rentStr(d, 'lid', 1, 64)
        && getAfter(rentLeasePath(usersCol, d.lid)).data.get('shareToken', null) == token
        && d.get('v', 0) == 1
        && rentStr(d, 'shop', 0, 80) && rentStr(d, 'tenant', 0, 80) && rentStr(d, 'place', 0, 150)
        && rentMoney(d, 'rent') && d.get('dueDay', 0) is int
        && d.get('ended', null) is bool && (d.get('endMonth', null) == null || rentMonth(d.endMonth))
        && d.get('months', null) is list && d.months.size() <= 36
        && d.get('updatedAt', null) is number
        // lid is fixed, except when the link moves with a change of unit (to the lease made from the old one).
        && (resource == null || resource.data.lid == d.lid
            || getAfter(rentLeasePath(usersCol, d.lid)).data.get('fromLeaseId', null) == resource.data.lid);
    }

    function rentPublicDeleteOk(usersCol, token) {
      return isOwnerIn(usersCol)
        || (rentRoleIn(usersCol) in ['owner', 'manager']
            && get(rentLeasePath(usersCol, resource.data.lid)).data.get('shareToken', null) == token
            && getAfter(rentLeasePath(usersCol, resource.data.lid)).data.get('shareToken', null) != token);
    }

    // Audit entries for rentals actions from users with a rentals role (a
    // rentals-only helper isn't approved for the shop).
    function rentAuditOk(usersCol) {
      return request.resource.data.get('action', '') is string
        && request.resource.data.action.matches('RENT_[A-Z_]{1,40}')
        && rentRoleIn(usersCol) != '';
    }

    // Settings › Rentals: defaults for NEW leases (rent_settings/default only).
    // Rentals roles read; owner/manager write; the owner deletes.
    function validRentSettings(usersCol, docId) {
      let d = request.resource.data;
      return docId == 'default'
        && canManageRent(usersCol)
        && rentWriterOk()
        && d.keys().hasOnly(['dueDay', 'increasePct', 'meterRate', 'tenantLink', 'receiptHeader', 'receiptAddress', 'updatedAt', 'updatedBy'])
        && d.get('dueDay', 10) is int && d.get('dueDay', 10) >= 1 && d.get('dueDay', 10) <= 28
        && d.get('increasePct', 5) is number && d.get('increasePct', 5) >= 0 && d.get('increasePct', 5) <= 100
        && rentNumOrNull(d, 'meterRate')
        && d.get('tenantLink', false) is bool
        && rentStr(d, 'receiptHeader', 0, 80) && rentStr(d, 'receiptAddress', 0, 200);
    }

    // ============================================
    // PRODUCTION COLLECTIONS
    // ============================================

    // Business collections (production and dev_ mirrors) live under one wildcard match.
    // Reads: see canReadRecord (own notifications/drafts/auto-save, settings/app only,
    // withdrawals by role access).
    match /{collection}/{docId} {
      allow get: if businessAccess(collection)
        && canReadRecord(baseName(collection), usersOf(collection), docId, true);
      allow list: if businessAccess(collection)
        && canReadRecord(baseName(collection), usersOf(collection), docId, false);
      // Stock records need an up-to-date app (clientVersion >= 3) on create/update.
      allow create: if businessAccess(collection)
        && appSettingsGuard(collection, docId)
        && (!(collection in stockCollections()) || writesCurrentClient(collection))
        && canCreateRecord(baseName(collection), usersOf(collection), docId);
      // Bills: full edits by owner/manager/creator; anyone else approved may only
      // record payment/due bookkeeping. Only an owner may change userId.
      // Cash, expenses, stock adjustments, items, counters: see canUpdateRecord.
      // Auto-saves and drafts: their own user only; notifications: the recipient
      // marks them read.
      allow update: if businessAccess(collection)
        && (appSettingsGuard(collection, docId) || managerShopSettingsOk(collection, docId))
        && (!(collection in stockCollections()) || writesCurrentClient(collection))
        && canUpdateRecord(baseName(collection), usersOf(collection), docId);
      // Bills: only an owner deletes them (#75: everyone else voids). Cash sessions,
      // items, counters, item frequency and settings: owner only. Expenses: owner/manager, or the creator
      // within 24 hours. Withdrawals/stock adjustments: owner/manager. Auto-saves,
      // drafts, notifications: their own user, or the owner (Clear Data).
      allow delete: if businessAccess(collection)
        && appSettingsGuard(collection, docId)
        && canDeleteRecord(baseName(collection), usersOf(collection), docId);
    }

    // Bill edit records (#121, validEditCreate): approved users read them (opened from the bill
    // details); created only with the bill update that raises its editCount; never changed;
    // the owner deletes them only once their bill is gone (delete for good, Clear Data).
    match /purchases/{billId}/edits/{editId} {
      allow read: if isApproved();
      allow create: if validEditCreate('users', 'purchases', billId, editId);
      allow update: if false;
      allow delete: if isAdmin() && !existsAfter(billPath('users', 'purchases', billId));
    }

    match /retailSales/{billId}/edits/{editId} {
      allow read: if isApproved();
      allow create: if validEditCreate('users', 'retailSales', billId, editId);
      allow update: if false;
      allow delete: if isAdmin() && !existsAfter(billPath('users', 'retailSales', billId));
    }

    match /wholesaleSales/{billId}/edits/{editId} {
      allow read: if isApproved();
      allow create: if validEditCreate('users', 'wholesaleSales', billId, editId);
      allow update: if false;
      allow delete: if isAdmin() && !existsAfter(billPath('users', 'wholesaleSales', billId));
    }

    match /dev_purchases/{billId}/edits/{editId} {
      allow read: if isApprovedIn('dev_users');
      allow create: if validEditCreate('dev_users', 'purchases', billId, editId);
      allow update: if false;
      allow delete: if isOwnerIn('dev_users') && !existsAfter(billPath('dev_users', 'purchases', billId));
    }

    match /dev_retailSales/{billId}/edits/{editId} {
      allow read: if isApprovedIn('dev_users');
      allow create: if validEditCreate('dev_users', 'retailSales', billId, editId);
      allow update: if false;
      allow delete: if isOwnerIn('dev_users') && !existsAfter(billPath('dev_users', 'retailSales', billId));
    }

    match /dev_wholesaleSales/{billId}/edits/{editId} {
      allow read: if isApprovedIn('dev_users');
      allow create: if validEditCreate('dev_users', 'wholesaleSales', billId, editId);
      allow update: if false;
      allow delete: if isOwnerIn('dev_users') && !existsAfter(billPath('dev_users', 'wholesaleSales', billId));
    }

    // State/lease writes: owner or manager only; anyone approved may mark it stale.
    // legacyScan (backfill completion state): owner/manager only, so staff can't
    // switch the backfill off; staff devices still backfill and ignore the denied
    // state write. No other doc ids.
    match /stockCheckpoints/{docId} {
      allow read: if isApproved();
      allow create, update: if checkpointRules('users', docId);
      allow delete: if isManagerIn('users');
    }

    match /dev_stockCheckpoints/{docId} {
      allow read: if isApprovedIn('dev_users');
      allow create, update: if checkpointRules('dev_users', docId);
      allow delete: if isManagerIn('dev_users');
    }

    match /rateHistory/{docId} {
      allow read: if isManagerIn('users');
      allow create: if validRateHistoryEntry('users');
      allow update, delete: if false;
    }

    match /dev_rateHistory/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create: if validRateHistoryEntry('dev_users');
      allow update, delete: if false;
    }

    // --- anomalies (#187 / #40): found by the daily scan on owner/manager
    // devices; only owner/manager may read them or mark them OK/fixed (#84 is
    // still open, so other users see nothing). Only an owner may delete.
    function validAnomaly(usersCol) {
      let d = request.resource.data;
      return isManagerIn(usersCol)
        && d.keys().hasOnly(['type', 'rule', 'severity', 'en', 'hi', 'refKind', 'refId', 'billType', 'billNumber',
                             'party', 'item', 'userId', 'user', 'amount', 'at', 'dayKey', 'hour', 'detectedBy',
                             'detectedAt', 'status', 'note', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
        && d.keys().hasAll(['type', 'severity', 'dayKey', 'status'])
        && d.type is string && d.dayKey is string
        && d.severity in ['high', 'medium', 'low']
        && d.status in ['open', 'ok', 'fixed'];
    }

    match /anomalies/{docId} {
      allow read: if isManagerIn('users');
      allow create, update: if validAnomaly('users');
      allow delete: if isOwnerIn('users');
    }

    match /dev_anomalies/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create, update: if validAnomaly('dev_users');
      allow delete: if isOwnerIn('dev_users');
    }

    // --- rate trends (#65): per-item-year rate stats + backfill status ---
    // rateStats/{itemId}_{YYYY} holds weekly (weeks: {'wYYYY-MM-DD': bucket})
    // and monthly (months: {'mYYYY-MM': bucket}) buckets of one item and year;
    // rateStats/_meta is the backfill status. Owner/manager only. Bucket maps
    // are size-capped (rules can't check every bucket; the app writes them).
    function validRateStats(usersCol, docId) {
      let d = request.resource.data;
      return isManagerIn(usersCol)
        && (docId == '_meta'
          ? d.keys().hasOnly(['backfillDone', 'backfillAt', 'bills', 'reads', 'months', 'by', 'byUserId', 'startedAt'])
          : d.keys().hasOnly(['itemId', 'year', 'weeks', 'months', 'updatedAt'])
            && d.keys().hasAll(['itemId', 'year', 'weeks', 'months'])
            && d.itemId is string && d.itemId.size() > 0
            && d.year is string && d.year.matches('^[0-9]{4}$')
            && docId == d.itemId + '_' + d.year
            && d.weeks is map && d.weeks.size() <= 54
            && d.months is map && d.months.size() <= 12);
    }

    match /rateStats/{docId} {
      allow read: if isManagerIn('users');
      allow create, update: if validRateStats('users', docId);
      allow delete: if isOwnerIn('users');
    }

    match /dev_rateStats/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create, update: if validRateStats('dev_users', docId);
      allow delete: if isOwnerIn('dev_users');
    }

    // --- month snapshots (redesign §7.6): monthStats/{YYYY-MM} ---
    // One doc per calendar month with that month's Money figures, per-item and
    // top-party totals, so Money / Insights compare with last year without
    // reading old bills. Built and rolled by owner/manager devices; read by them.
    function validMonthStats(usersCol, docId) {
      let d = request.resource.data;
      return isManagerIn(usersCol)
        && docId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.keys().hasOnly(['month', 'v', 'm', 'items', 'customers', 'suppliers', 'categories', 'days', 'builtAt', 'stale', 'staleAt'])
        && d.keys().hasAll(['month', 'v', 'm'])
        && d.month == docId
        && d.v is int
        && d.m is map;
    }

    // Saving, editing or deleting a bill, expense or withdrawal dated in an earlier
    // month marks that month stale (firestore-service.js noteMonthWrite, a merge
    // write): any approved user, only `stale: true` and its time; a month without a
    // snapshot gets a stub { month, stale, staleAt }.
    function monthStaleMarkOnly(usersCol, docId) {
      let d = request.resource.data;
      return isApprovedIn(usersCol)
        && docId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.get('stale', false) == true
        && d.get('month', null) == docId
        && d.get('staleAt', null) is number
        && (resource == null
            ? d.keys().hasOnly(['month', 'stale', 'staleAt'])
            : d.diff(resource.data).affectedKeys().hasOnly(['stale', 'staleAt']));
    }

    match /monthStats/{docId} {
      allow read: if isManagerIn('users');
      allow create, update: if validMonthStats('users', docId) || monthStaleMarkOnly('users', docId);
      allow delete: if isOwnerIn('users');
    }

    match /dev_monthStats/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create, update: if validMonthStats('dev_users', docId) || monthStaleMarkOnly('dev_users', docId);
      allow delete: if isOwnerIn('dev_users');
    }

    // --- Test in Production (#217) ---
    // tipHealth/{deviceId}_{YYYYMMDD}: daily per-device counters, written with
    // set+merge and FieldValue.increment. Any approved user may create/update
    // only their own device docs (uid, deviceId and day can't change); the
    // per-version map is capped. tipFailures/{deviceId}_{YYYYMMDD}_{1..20}:
    // create-only samples, so at most 20 per device per day. Owner/manager read.
    function validTipHealth(usersCol, docId) {
      let d = request.resource.data;
      return isApprovedIn(usersCol)
        && d.keys().hasOnly(['uid', 'deviceId', 'day', 'platform', 'appVersion', 'buildId', 'updatedAt', 'v'])
        && d.keys().hasAll(['uid', 'deviceId', 'day', 'v'])
        && d.uid == request.auth.uid
        && d.deviceId is string && d.deviceId.matches('^[a-z0-9]{6,20}$')
        && d.day is string && d.day.matches('^[0-9]{8}$')
        && docId == d.deviceId + '_' + d.day
        && d.v is map && d.v.size() <= 4
        && shortStringOrAbsent(d, 'platform', 16)
        && shortStringOrAbsent(d, 'appVersion', 20)
        && shortStringOrAbsent(d, 'buildId', 64)
        && (!('updatedAt' in d) || d.updatedAt == request.time)
        && (resource == null
            || (resource.data.uid == request.auth.uid
                && resource.data.deviceId == d.deviceId
                && resource.data.day == d.day));
    }

    function validTipFailure(usersCol, docId) {
      let d = request.resource.data;
      return isApprovedIn(usersCol)
        && d.keys().hasOnly(['uid', 'deviceId', 'day', 'test', 'result', 'reason', 'reasonName', 'flags', 'props',
                             'errors', 'durationMs', 'appVersion', 'buildId', 'platform', 'at', 'createdAt'])
        && d.keys().hasAll(['uid', 'deviceId', 'day', 'test', 'result', 'reason', 'at'])
        && d.uid == request.auth.uid
        && d.deviceId is string && d.deviceId.matches('^[a-z0-9]{6,20}$')
        && d.day is string && d.day.matches('^[0-9]{8}$')
        && docId.matches('^' + d.deviceId + '_' + d.day + '_([1-9]|1[0-9]|20)$')
        && d.test is string && d.test.size() <= 32
        && d.result in ['fail', 'abandoned', 'expired', 'rolled_back']
        && d.reason is int && d.reason >= 0 && d.reason <= 32767
        && d.at is number
        && (!('flags' in d) || (d.flags is map && d.flags.size() <= 12))
        && (!('props' in d) || (d.props is map && d.props.size() <= 12))
        && shortStringOrAbsent(d, 'reasonName', 40)
        && shortStringOrAbsent(d, 'appVersion', 20)
        && shortStringOrAbsent(d, 'buildId', 64)
        && shortStringOrAbsent(d, 'platform', 16)
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    match /tipHealth/{docId} {
      allow read: if isManagerIn('users');
      allow create, update: if validTipHealth('users', docId);
      allow delete: if isOwnerIn('users');
    }

    match /dev_tipHealth/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create, update: if validTipHealth('dev_users', docId);
      allow delete: if isOwnerIn('dev_users');
    }

    match /tipFailures/{docId} {
      allow read: if isManagerIn('users');
      allow create: if validTipFailure('users', docId);
      allow update: if false;
      allow delete: if isOwnerIn('users');
    }

    match /dev_tipFailures/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create: if validTipFailure('dev_users', docId);
      allow update: if false;
      allow delete: if isOwnerIn('dev_users');
    }

    match /users/{userId} {
      allow read: if canReadProfile('users', userId);
      allow create: if canCreateProfile(userId);
      allow update: if canUpdateProfile('users', userId);
      allow delete: if isAdmin() && resource.data.get('role', '') != 'owner';
    }

    match /users/{userId}/preferences/{prefId} {
      allow read, write: if isApproved() && request.auth.uid == userId;
    }

    // Audit logs - approved users append entries as themselves; only owners read,
    // and only owners delete entries older than 90 days (retention cleanup).
    match /auditLogs/{logId} {
      allow create: if (isApproved() || rentAuditOk('users')) && validAuditEntry();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && isExpiredAuditEntry();
    }

    // Telemetry - append-only error reports; only owners read/delete (Clear All).
    match /telemetry/{docId} {
      allow create: if isApproved() && validTelemetryEntry();
      allow update: if false;
      allow read, delete: if isAdmin();
    }

    // Tenant rent-history link: anyone with the exact token reads one doc; nobody lists.
    match /rent_public/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if validRentPublic('users', token);
      allow delete: if resource != null && rentPublicDeleteOk('users', token);
    }

    match /dev_rent_public/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if validRentPublic('dev_users', token);
      allow delete: if resource != null && rentPublicDeleteOk('dev_users', token);
    }

    // Rentals (#170): helpers above. Deletes: owner, or move-out removing unpaid later months.
    match /rent_properties/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_properties', 'users', docId);
      allow update: if rentUpdateOk('rent_properties', 'users', docId);
      allow delete: if rentDeleteOk('rent_properties', 'users');
    }

    match /rent_units/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_units', 'users', docId);
      allow update: if rentUpdateOk('rent_units', 'users', docId);
      allow delete: if rentDeleteOk('rent_units', 'users');
    }

    match /rent_tenants/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_tenants', 'users', docId);
      allow update: if rentUpdateOk('rent_tenants', 'users', docId);
      allow delete: if rentDeleteOk('rent_tenants', 'users');
    }

    match /rent_leases/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_leases', 'users', docId);
      allow update: if rentUpdateOk('rent_leases', 'users', docId);
      allow delete: if rentDeleteOk('rent_leases', 'users');
    }

    match /rent_charges/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_charges', 'users', docId);
      allow update: if rentUpdateOk('rent_charges', 'users', docId);
      allow delete: if rentDeleteOk('rent_charges', 'users');
    }

    match /rent_settings/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create, update: if validRentSettings('users', docId);
      allow delete: if rentRoleIn('users') == 'owner';
    }

    match /dev_rent_settings/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create, update: if validRentSettings('dev_users', docId);
      allow delete: if rentRoleIn('dev_users') == 'owner';
    }

    // Rent receipts and their yearly counters (helpers above): rentals roles read;
    // created with a payment, or later for a payment without one (its writer or owner/manager);
    // never edited except cancel (owner/manager); never deleted.
    match /rent_receipts/{rid} {
      allow read: if rentRoleIn('users') != '';
      allow create: if canWriteRent('users') && validRentReceiptCreate('users', rid)
        && (request.resource.data.get('by', '') == request.auth.uid || canManageRent('users'));
      allow update: if canManageRent('users') && rentReceiptVoidOk('users');
      allow delete: if false;
    }

    match /dev_rent_receipts/{rid} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if canWriteRent('dev_users') && validRentReceiptCreate('dev_users', rid)
        && (request.resource.data.get('by', '') == request.auth.uid || canManageRent('dev_users'));
      allow update: if canManageRent('dev_users') && rentReceiptVoidOk('dev_users');
      allow delete: if false;
    }

    match /rent_counters/{id} {
      allow read: if rentRoleIn('users') != '';
      allow create, update: if canWriteRent('users') && validRentCounter('users', id);
      allow delete: if false;
    }

    match /dev_rent_counters/{id} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create, update: if canWriteRent('dev_users') && validRentCounter('dev_users', id);
      allow delete: if false;
    }

    match /dev_rent_properties/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_properties', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_properties', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_properties', 'dev_users');
    }

    match /dev_rent_units/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_units', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_units', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_units', 'dev_users');
    }

    match /dev_rent_tenants/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_tenants', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_tenants', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_tenants', 'dev_users');
    }

    match /dev_rent_leases/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_leases', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_leases', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_leases', 'dev_users');
    }

    match /dev_rent_charges/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_charges', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_charges', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_charges', 'dev_users');
    }

    // ============================================
    // DEVELOPMENT ENVIRONMENT COLLECTIONS (dev_ prefix)
    // Same rules as production, with dev_users as the profile source.
    // ============================================

    match /dev_users/{userId} {
      allow read: if canReadProfile('dev_users', userId);
      allow create: if canCreateProfile(userId);
      allow update: if canUpdateProfile('dev_users', userId);
      allow delete: if isOwnerIn('dev_users') && resource.data.get('role', '') != 'owner';
    }

    match /dev_users/{userId}/preferences/{prefId} {
      allow read, write: if isApprovedIn('dev_users') && request.auth.uid == userId;
    }

    match /dev_auditLogs/{logId} {
      allow create: if (isApprovedIn('dev_users') || rentAuditOk('dev_users')) && validAuditEntry();
      allow read: if isOwnerIn('dev_users');
      allow update: if false;
      allow delete: if isOwnerIn('dev_users') && isExpiredAuditEntry();
    }

    match /dev_telemetry/{docId} {
      allow create: if isApprovedIn('dev_users') && validTelemetryEntry();
      allow update: if false;
      allow read, delete: if isOwnerIn('dev_users');
    }
  }
}

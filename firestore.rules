rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPERS
    // Production collections use the 'users' collection as the source of a
    // caller's profile; development (dev_ prefix) collections use 'dev_users'.
    // ============================================

    function isSignedIn() {
      return request.auth != null;
    }

    function profilePath(usersCol) {
      return /databases/$(database)/documents/$(usersCol)/$(request.auth.uid);
    }

    // Approved = has a profile whose status is not pending/rejected and whose role is known.
    // Legacy approved profiles have status 'active', 'approved' or no status field at all.
    function isApprovedIn(usersCol) {
      return isSignedIn()
        && exists(profilePath(usersCol))
        && !(get(profilePath(usersCol)).data.get('status', '') in ['pending', 'rejected'])
        && get(profilePath(usersCol)).data.get('role', '') in ['owner', 'manager', 'staff'];
    }

    function isOwnerIn(usersCol) {
      return isApprovedIn(usersCol) && get(profilePath(usersCol)).data.get('role', '') == 'owner';
    }

    function isApproved() {
      return isApprovedIn('users');
    }

    function isAdmin() {
      return isOwnerIn('users');
    }

    // Shared business data: every approved user (owner/manager/staff) can read/write.
    function businessCollections() {
      return [
        'purchases', 'retailSales', 'wholesaleSales', 'items', 'expenses',
        'stockAdjustments', 'withdrawals', 'cashManagement', 'cashSessions',
        'settings', 'itemFrequency', 'notifications', 'autoSaves', 'drafts',
        'counters'
      ];
    }

    function devBusinessCollections() {
      return [
        'dev_purchases', 'dev_retailSales', 'dev_wholesaleSales', 'dev_items', 'dev_expenses',
        'dev_stockAdjustments', 'dev_withdrawals', 'dev_cashManagement', 'dev_cashSessions',
        'dev_settings', 'dev_itemFrequency', 'dev_notifications', 'dev_autoSaves', 'dev_drafts',
        'dev_counters'
      ];
    }

    // --- bills (purchases / retail / wholesale sales) ---

    function billCollections() {
      return ['purchases', 'retailSales', 'wholesaleSales'];
    }

    // --- bill edit window (#87; days per role in Roles & access, #84) ---
    // Clock: the bill's `createdAt`, the server time of its first save
    // (firestore-service.js saveBill; validBillCreate requires it to equal
    // request.time and nobody but the owner can change it). Bills without a
    // server createdAt (saved before #87 / by old apps) are owner-only.
    // Days: settings/app.roleAccess.<role>.editDays (int 0-30, else 2).
    // settings/app is already read for the clientVersion gate on bill writes.
    function settingsAppPath(usersCol) {
      return /databases/$(database)/documents/$(usersCol == 'users' ? 'settings' : 'dev_settings')/app;
    }

    function billEditDays(usersCol) {
      let role = get(profilePath(usersCol)).data.get('role', '');
      let p = settingsAppPath(usersCol);
      let access = exists(p) ? get(p).data.get('roleAccess', {}) : {};
      let roleAccess = access is map ? access.get(role, {}) : {};
      let d = roleAccess is map ? roleAccess.get('editDays', 2) : 2;
      return (d is int && d >= 0 && d <= 30) ? d : 2;
    }

    function withinBillWindow(usersCol) {
      let c = resource.data.get('createdAt', null);
      return c is timestamp && request.time < c + duration.value(billEditDays(usersCol), 'd');
    }

    function canDeleteBill(usersCol) {
      // resource is null when deleting a doc that is already gone (no-op).
      return isOwnerIn(usersCol)
        || (isApprovedIn(usersCol)
            && (resource == null
                || (resource.data.get('userId', null) == request.auth.uid && withinBillWindow(usersCol))));
    }

    function keepsBillOwner(usersCol) {
      return isOwnerIn(usersCol)
        || request.resource.data.get('userId', null) == resource.data.get('userId', null);
    }

    // Full edits (the owner is handled in canUpdateBill): a manager, or the bill's
    // creator, inside the edit window; createdAt never changes.
    function canFullyEditBill(usersCol) {
      return (isManagerIn(usersCol)
              || (resource.data.get('userId', null) != null
                  && resource.data.get('userId', null) == request.auth.uid))
        && withinBillWindow(usersCol)
        && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null);
    }

    // Everyone else may only touch payment/due bookkeeping written by the app:
    // payments (outstanding.js applyPaymentTransaction), clearing (markAsCleared,
    // wholesale markSaleAsCleared) and the legacy backfill (openDue, clientVersion,
    // a missing numeric timestamp). `timestamp` and `id` may only be filled in,
    // never changed.
    function bookkeepingOnly(docId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly([
          'payment', 'payments', 'dueAmount', 'openDue', 'clientVersion',
          'cleared', 'clearedAt', 'clearedBy', 'clearedByName',
          'timestamp', 'id'
        ])
        && (!changed.hasAny(['timestamp']) || !(resource.data.get('timestamp', null) is number))
        && (!changed.hasAny(['id']) || (!('id' in resource.data) && request.resource.data.id == docId));
    }

    // --- money validation (#19) ---

    // `key` is absent from map `m`, or a number >= 0.
    function nonNegativeOrAbsent(m, key) {
      return !(key in m) || (m[key] is number && m[key] >= 0);
    }

    // The bill's due before this write, as readPayment() reads it (nested
    // payment.due first); null when it isn't stored as a number.
    function storedDue() {
      let p = resource.data.get('payment', {});
      let due = (p is map && 'due' in p) ? p.due : resource.data.get('dueAmount', resource.data.get('due', null));
      return due is number ? due : null;
    }

    // Money fields that a write changes must be numbers (full edits and creates).
    function changedMoneyTypesOk(keys) {
      let d = request.resource.data;
      return (!keys.hasAny(['total']) || d.total is number)
        && (!keys.hasAny(['dueAmount']) || d.dueAmount is number)
        && (!keys.hasAny(['cashPayment']) || d.cashPayment is number)
        && (!keys.hasAny(['onlinePayment']) || d.onlinePayment is number)
        && (!keys.hasAny(['payment'])
            || (d.payment is map
                && (!('cash' in d.payment) || d.payment.cash is number)
                && (!('online' in d.payment) || d.payment.online is number)
                && (!('due' in d.payment) || d.payment.due is number)));
    }

    // payments[] may only grow by one entry; existing entries stay unchanged and
    // the new entry has a numeric amount >= 0 (#19).
    function appendsOneEntry(field) {
      let oldList = resource.data.get(field, []);
      let newList = request.resource.data.get(field, []);
      return oldList is list && newList is list
        && newList.size() == oldList.size() + 1
        && (oldList.size() == 0 || newList[0:oldList.size()] == oldList)
        && newList[oldList.size()] is map
        && newList[oldList.size()].get('amount', null) is number
        && newList[oldList.size()].amount >= 0;
    }

    // Payment bookkeeping by someone who may not fully edit the bill: amounts are
    // numbers >= 0, the due never goes up, payment.due and dueAmount agree, and
    // payments[] is append-only (outstanding.js applyPaymentTransaction /
    // applyWriteOffTransaction, wholesale markSaleAsCleared).
    function paymentEditOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      let before = storedDue();
      return (!changed.hasAny(['payment'])
              || (d.payment is map
                  && nonNegativeOrAbsent(d.payment, 'cash')
                  && nonNegativeOrAbsent(d.payment, 'online')
                  && nonNegativeOrAbsent(d.payment, 'due')
                  && nonNegativeOrAbsent(d.payment, 'writtenOff')
                  && (!('due' in d.payment) || before == null || d.payment.due <= before + 0.01)))
        && (!changed.hasAny(['dueAmount'])
            || (d.dueAmount is number && d.dueAmount >= 0
                && (before == null || d.dueAmount <= before + 0.01)
                && (!(d.get('payment', {}) is map) || !('due' in d.get('payment', {})) || d.payment.due == d.dueAmount)))
        && (!changed.hasAny(['payments']) || appendsOneEntry('payments'));
    }

    function canUpdateBill(usersCol, docId) {
      return keepsBillOwner(usersCol)
        && (isOwnerIn(usersCol)
            || (canFullyEditBill(usersCol) && changedMoneyTypesOk(request.resource.data.diff(resource.data).affectedKeys()))
            || (bookkeepingOnly(docId) && paymentEditOk()));
    }

    // New bills: the creator's own uid (when set), numeric money fields and, when
    // sent, createdAt = the server time of this write (older apps don't send it).
    function validBillCreate() {
      return request.resource.data.get('userId', request.auth.uid) == request.auth.uid
        && changedMoneyTypesOk(request.resource.data.keys())
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time);
    }

    // ============================================
    // CASH, EXPENSES, STOCK ADJUSTMENTS, ITEMS, COUNTERS (#18)
    // The owner may write these freely (repairs, backup restore). Everyone else
    // is limited to the writes the app makes.
    // ============================================

    function isMember(usersCol) {
      return isApprovedIn(usersCol) && !isManagerIn(usersCol);
    }

    // Who created a record (expenses carry userId and createdBy).
    function createdByCaller() {
      return resource.data.get('userId', resource.data.get('createdBy', null)) == request.auth.uid;
    }

    // Members may change their own record for 24 hours after it was made
    // (fixing a typo); after that only an owner/manager may.
    function withinEditWindow() {
      let t = resource.data.get('timestamp', null);
      return t is number
        && t > request.time.toMillis() - 86400000
        && t < request.time.toMillis() + 86400000;
    }

    // Legacy backfill (firestore-service.js backfillLegacyTimestamps): fills a
    // missing numeric timestamp (+ clientVersion on stock records), nothing else.
    function legacyBackfillOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['timestamp', 'clientVersion'])
        && changed.hasAny(['timestamp'])
        && !(resource.data.get('timestamp', null) is number)
        && request.resource.data.timestamp is number;
    }

    function amountOk() {
      return request.resource.data.get('amount', null) is number && request.resource.data.amount >= 0;
    }

    // Expenses / withdrawals: anyone approved records their own, with a numeric amount.
    function validLedgerCreate() {
      return amountOk() && request.resource.data.get('userId', null) == request.auth.uid;
    }

    function expenseEditOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['type', 'personName', 'amount', 'remarks', 'updatedAt', 'updatedBy', 'updatedByName'])
        && (!changed.hasAny(['amount']) || amountOk());
    }

    function canUpdateExpense(usersCol) {
      return legacyBackfillOnly()
        || (isManagerIn(usersCol)
            && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']) || amountOk()))
        || (createdByCaller() && withinEditWindow() && expenseEditOk());
    }

    function canDeleteExpense(usersCol) {
      return isManagerIn(usersCol) || resource == null || (createdByCaller() && withinEditWindow());
    }

    // Stock adjustments: anyone approved may record one (stock.js applyStockAdjustment).
    function validAdjustmentCreate() {
      let d = request.resource.data;
      return d.get('userId', null) == request.auth.uid
        && d.get('adjustType', null) in ['add', 'remove', 'set']
        && d.get('quantity', null) is number && d.quantity >= 0
        && d.get('itemId', null) != null;
    }

    // --- cash sessions (cashManagement) ---

    // cash-management.js signIn
    function validCashCreate() {
      let d = request.resource.data;
      return d.get('openingBalance', null) is number && d.openingBalance >= 0
        && d.get('signedOut', false) == false
        && d.get('userId', null) == request.auth.uid;
    }

    // Deposits and due-payment legs are appended one at a time (arrayUnion, or
    // outstanding.js applyPaymentTransaction). Also allowed on a closed session:
    // an entry queued offline must not be lost because another device closed it.
    function cashAppendOk() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() == 1
        && changed.hasOnly(['duePayments', 'cashDeposits'])
        && appendsOneEntry(changed.hasAny(['duePayments']) ? 'duePayments' : 'cashDeposits');
    }

    // A day the app closed automatically without a real count (#101; older
    // apps wrote closingBalance 0 and no `counted`).
    function wasAutoClosedUncounted() {
      return resource.data.get('signedOut', false) == true
        && resource.data.get('autoSignedOut', false) == true
        && resource.data.get('counted', null) != true;
    }

    // Sign-out (counted) or the automatic close of a past day (not counted).
    // A counted sign-out may also replace an automatic close: older apps
    // (v1.3/v1.4) sign out with a plain update and would otherwise lose the count.
    function cashCloseOk() {
      let d = request.resource.data;
      return (resource.data.get('signedOut', false) != true
              || (wasAutoClosedUncounted() && d.get('closingBalance', null) is number))
        && d.get('signedOut', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'closingBalance', 'expectedBalance', 'difference', 'signOutTime', 'signedOut', 'counted',
             'transactions', 'closingNotes', 'flags', 'autoSignedOut', 'autoClosed', 'autoSignOutReason'])
        && (d.get('closingBalance', null) == null || (d.closingBalance is number && d.closingBalance >= 0))
        && (d.get('counted', true) == false || d.get('closingBalance', null) is number)
        && (d.get('expectedBalance', null) == null || d.expectedBalance is number);
    }

    // Recording the real count for a day that was closed without one (#101).
    function cashLateCountOk() {
      let d = request.resource.data;
      let r = resource.data;
      return r.get('signedOut', false) == true
        && (r.get('counted', null) == false || (!('counted' in r) && r.get('autoSignedOut', false) == true))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'closingBalance', 'difference', 'counted', 'countedLate', 'countedAt', 'countedBy', 'countedByName'])
        && d.get('closingBalance', null) is number && d.closingBalance >= 0
        && d.get('counted', false) == true
        && d.get('countedBy', null) == request.auth.uid;
    }

    // --- items: owner/manager create and edit; only the owner deletes ---

    function itemFieldsOk(keys) {
      let d = request.resource.data;
      return (!keys.hasAny(['name']) || d.name is string)
        && (!keys.hasAny(['rates']) || d.rates is list)
        && (!keys.hasAny(['saleRates']) || d.saleRates is list)
        && (!keys.hasAny(['wholesaleRates']) || d.wholesaleRates is list);
    }

    // --- bill-number counters (helpers.js _nextCounterValue): +1 per transaction ---

    function counterFields() {
      return ['next', 'initialized', 'prefix', 'date', 'updatedAt'];
    }

    function validCounterCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly(counterFields()) && d.get('next', null) is number && d.next >= 1;
    }

    function counterIncrementOk() {
      let d = request.resource.data;
      let r = resource.data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(counterFields())
        && d.get('next', null) is number
        && (r.get('initialized', false) == true && r.get('next', null) is number
            ? d.next == r.next + 1
            // Not yet seeded from today's bills: may jump forward, never back.
            : (d.next >= 1 && (!(r.get('next', null) is number) || d.next > r.next)));
    }

    function baseName(collection) {
      return collection.matches('dev_.*') ? collection.replace('^dev_', '') : collection;
    }

    function usersOf(collection) {
      return collection.matches('dev_.*') ? 'dev_users' : 'users';
    }

    function canCreateRecord(base, u) {
      return isOwnerIn(u)
        || (base in billCollections() ? validBillCreate()
          : base in ['expenses', 'withdrawals'] ? validLedgerCreate()
          : base == 'stockAdjustments' ? validAdjustmentCreate()
          : base in ['cashManagement', 'cashSessions'] ? validCashCreate()
          : base == 'items' ? isManagerIn(u) && itemFieldsOk(request.resource.data.keys())
          : base == 'counters' ? validCounterCreate()
          : true);
    }

    function canUpdateRecord(base, u, docId) {
      return base in billCollections() ? canUpdateBill(u, docId)
        : isOwnerIn(u) ? true
        : base == 'expenses' ? canUpdateExpense(u)
        : base in ['withdrawals', 'stockAdjustments']
          ? (legacyBackfillOnly()
             || (isManagerIn(u)
                 && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']) || amountOk())))
        : base in ['cashManagement', 'cashSessions'] ? (cashAppendOk() || cashCloseOk() || cashLateCountOk())
        : base == 'items' ? isManagerIn(u) && itemFieldsOk(request.resource.data.diff(resource.data).affectedKeys())
        : base == 'counters' ? counterIncrementOk()
        : true;
    }

    function canDeleteRecord(base, u) {
      return base in billCollections() ? canDeleteBill(u)
        : isOwnerIn(u) ? true
        : base == 'expenses' ? canDeleteExpense(u)
        : base in ['withdrawals', 'stockAdjustments'] ? isManagerIn(u)
        : base in ['cashManagement', 'cashSessions', 'items', 'counters'] ? false
        : true;
    }

    // settings/app (minClientVersion) can lock every outdated phone out: owner only.
    function appSettingsGuard(collection, docId) {
      return !(docId == 'app' && collection in ['settings', 'dev_settings'])
        || isOwnerIn(collection == 'settings' ? 'users' : 'dev_users');
    }

    // Stock records: writes must come from an app version that maintains the stock
    // checkpoint (sets clientVersion >= 3). Blocks outdated apps from creating or
    // overwriting bills/adjustments. DEPLOY ONLY AFTER every phone runs the new app.
    function stockCollections() {
      return ['purchases', 'retailSales', 'wholesaleSales', 'stockAdjustments',
              'dev_purchases', 'dev_retailSales', 'dev_wholesaleSales', 'dev_stockAdjustments'];
    }

    // The clientVersion gate is switched on by the owner (settings/app.enforceClientVersion
    // = true, dev_settings/app for dev_) once every phone runs the new app, so these rules
    // can be deployed before the old APK is retired.
    function clientGateOn(collection) {
      let settingsPath = /databases/$(database)/documents/$(collection.matches('dev_.*') ? 'dev_settings' : 'settings')/app;
      return exists(settingsPath) && get(settingsPath).data.get('enforceClientVersion', false) == true;
    }

    function writesCurrentClient(collection) {
      return !clientGateOn(collection) || request.resource.data.get('clientVersion', 0) >= 3;
    }

    function businessAccess(collection) {
      return (collection in businessCollections() && isApproved())
        || (collection in devBusinessCollections() && isApprovedIn('dev_users'));
    }

    // --- stock checkpoint (stockCheckpoints/current) ---

    function isManagerIn(usersCol) {
      return isApprovedIn(usersCol) && get(profilePath(usersCol)).data.get('role', '') in ['owner', 'manager'];
    }

    // Fields any approved user may write to mark the checkpoint stale.
    function staleMarkOnly() {
      return request.resource.data.get('stale', false) == true
        && (resource == null
            ? request.resource.data.keys().hasOnly(['stale', 'staleCount', 'staleAt', 'staleReason', 'staleBy'])
            : request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['stale', 'staleCount', 'staleAt', 'staleReason', 'staleBy']));
    }

    function checkpointRules(usersCol, docId) {
      return docId == 'current'
        ? (isManagerIn(usersCol) || (isApprovedIn(usersCol) && staleMarkOnly()))
        : docId == 'legacyScan'
          ? isManagerIn(usersCol)
          : isApprovedIn(usersCol);
    }

    // --- item rate/name history (rateHistory, #82 / #65 phase 1) ---
    // Append-only: owner/manager create entries for their own uid; nobody
    // updates or deletes them. `index` = position in the rate list (#65);
    // `source` = where the change was made (Items page row, edit dialog, Excel import).
    function validRateHistoryEntry(usersCol) {
      let d = request.resource.data;
      return isManagerIn(usersCol)
        && d.keys().hasOnly(['itemId', 'itemName', 'field', 'old', 'new', 'by', 'byUserId', 'at', 'source', 'flags', 'index'])
        && d.keys().hasAll(['itemId', 'field', 'byUserId', 'at'])
        && d.itemId is string && d.itemId.size() > 0
        && d.field in ['purchase', 'wholesale', 'retail', 'name', 'hindiName']
        && d.byUserId == request.auth.uid
        && d.at is number
        && (!('source' in d) || d.source in ['modal', 'inline', 'import'])
        && (!('index' in d) || (d.index is int && d.index >= 0 && d.index <= 20));
    }

    // --- user profile rules (shared by users and dev_users) ---

    function canReadProfile(usersCol, userId) {
      // A pending/rejected user must still be able to read their own profile at login.
      return isApprovedIn(usersCol) || (isSignedIn() && request.auth.uid == userId);
    }

    function canCreateProfile(userId) {
      // Self-registration only, and always as a pending staff member.
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('status', '') == 'pending'
        && request.resource.data.get('role', '') == 'staff'
        && !('rentRole' in request.resource.data);
    }

    function canUpdateProfile(usersCol, userId) {
      return isOwnerIn(usersCol)
        || (isSignedIn()
            && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['role', 'status', 'approvedAt', 'approvedBy', 'rentRole']));
    }

    // --- audit logs (#55) and telemetry (#122): append-only ---

    // The caller's own uid; `serverTime` (FieldValue.serverTimestamp) is the
    // trusted time. `timestamp` (client clock, used for ordering) may not be in
    // the future and only lags when the entry was queued offline (up to 3 days);
    // entries without serverTime (older apps) must be within 10 minutes.
    function validAuditEntry() {
      let d = request.resource.data;
      let now = request.time.toMillis();
      return d.keys().hasOnly(['action', 'userId', 'userName', 'userRole', 'details', 'timestamp', 'date', 'serverTime'])
        && d.get('userId', null) == request.auth.uid
        && d.get('action', null) is string && d.action.size() <= 64
        && d.get('timestamp', null) is number
        && d.timestamp <= now + 600000
        && (d.get('serverTime', null) == request.time
            ? d.timestamp >= now - 259200000
            : (!('serverTime' in d) && d.timestamp >= now - 600000))
        && (!('userName' in d) || (d.userName is string && d.userName.size() <= 200))
        && (!('userRole' in d) || (d.userRole is string && d.userRole.size() <= 32))
        && (!('details' in d) || (d.details is map && d.details.size() <= 40));
    }

    // Owner cleanup (audit.js cleanupOldLogs): only entries older than 90 days.
    function isExpiredAuditEntry() {
      return resource.data.get('timestamp', null) is number
        && resource.data.timestamp < request.time.toMillis() - 7776000000;
    }

    function shortStringOrAbsent(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }

    // One document per sync of a grouped error (telemetry.js syncToFirestore).
    function validTelemetryEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['type', 'message', 'source', 'line', 'column', 'stack', 'context', 'timestamp',
                               'date', 'url', 'userAgent', 'userId', 'userName', 'userRole', 'fingerprint',
                               'count', 'occurrences', 'lastSeen', 'firstSeen'])
        && d.get('userId', null) == request.auth.uid
        && d.get('fingerprint', null) is string && d.fingerprint.size() <= 40
        && d.get('count', null) is int && d.count >= 1 && d.count <= 100
        && (!('occurrences' in d) || (d.occurrences is list && d.occurrences.size() <= 10))
        && shortStringOrAbsent(d, 'type', 40)
        && shortStringOrAbsent(d, 'message', 1000)
        && shortStringOrAbsent(d, 'source', 500)
        && shortStringOrAbsent(d, 'stack', 4000)
        && shortStringOrAbsent(d, 'context', 2000)
        && shortStringOrAbsent(d, 'date', 40)
        && shortStringOrAbsent(d, 'url', 500)
        && shortStringOrAbsent(d, 'userAgent', 500)
        && shortStringOrAbsent(d, 'userName', 200)
        && shortStringOrAbsent(d, 'userRole', 32);
    }

    // ============================================
    // RENTALS (#170): rent_* collections (dev_rent_* in development), roles
    // per business (#149). The shop owner owns every business; anyone else
    // needs users/{uid}.rentRole = 'manager' | 'member' (set by the owner).
    // A shop role alone gives no rentals access, and a rentals role alone
    // (shop role 'none') gives no shop access. See docs/rentals-design.md.
    // ============================================

    function rentProfile(usersCol) {
      return get(profilePath(usersCol)).data;
    }

    // 'owner' | 'manager' | 'member' | '' (no access)
    function rentRoleIn(usersCol) {
      return !(isSignedIn() && exists(profilePath(usersCol))) ? ''
        : rentProfile(usersCol).get('status', '') in ['pending', 'rejected'] ? ''
        : rentProfile(usersCol).get('role', '') == 'owner' ? 'owner'
        : rentProfile(usersCol).get('rentRole', '') in ['manager', 'member'] ? rentProfile(usersCol).rentRole
        : '';
    }

    // Owner decision (2026-10-25): anyone with a rentals role records payments
    // and keeps the records up to date. Deletes and Access stay owner-only;
    // correcting a charge's amount stays owner/manager.
    function canWriteRent(usersCol) {
      return rentRoleIn(usersCol) != '';
    }

    function canManageRent(usersCol) {
      return rentRoleIn(usersCol) in ['owner', 'manager'];
    }

    function rentPrefix(usersCol) {
      return usersCol == 'dev_users' ? 'dev_' : '';
    }

    function rentPath(usersCol, coll, id) {
      return /databases/$(database)/documents/$(rentPrefix(usersCol) + coll)/$(id);
    }

    function rentLeasePath(usersCol, leaseId) {
      return rentPath(usersCol, 'rent_leases', leaseId);
    }

    function rentChargePath(usersCol, leaseId, month) {
      return rentPath(usersCol, 'rent_charges', leaseId + '_' + month);
    }

    function rentStr(d, key, min, max) {
      return d.get(key, '') is string && d.get(key, '').size() >= min && d.get(key, '').size() <= max;
    }

    function rentMonth(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function rentMoney(d, key) {
      return d.get(key, null) is number && d.get(key, 0) >= 0;
    }

    function rentNumOrNull(d, key) {
      return d.get(key, null) == null || (d.get(key, null) is number && d.get(key, 0) >= 0);
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // The month after 'YYYY-MM'.
    function nextMonth(m) {
      return int(m[5:7]) == 12 ? string(int(m[0:4]) + 1) + '-01' : m[0:5] + pad2(int(m[5:7]) + 1);
    }

    // This month in India (IST = UTC+5:30), as 'YYYY-MM'.
    function rentThisMonth() {
      let ist = request.time + duration.value(330, 'm');
      return string(ist.year()) + '-' + pad2(ist.month());
    }

    // Every rentals write names its writer (audit: who recorded what).
    function rentWriterOk() {
      return request.resource.data.get('updatedBy', null) == request.auth.uid;
    }

    // Who/when created a record never changes.
    function rentCreationKept() {
      return request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        && request.resource.data.get('createdBy', null) == resource.data.get('createdBy', null);
    }

    function rentMeta() {
      return ['archived', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'];
    }

    // Shape of properties, units, tenants and leases.
    function validRentDoc(base) {
      let d = request.resource.data;
      return d.get('archived', false) is bool
        && rentWriterOk()
        && (base == 'rent_properties'
          ? d.keys().hasOnly(['name', 'address', 'kind', 'notes'].concat(rentMeta()))
            && rentStr(d, 'name', 1, 80) && rentStr(d, 'address', 0, 200) && rentStr(d, 'notes', 0, 500)
            && d.get('kind', 'other') in ['house', 'shop', 'flat', 'plot', 'godown', 'other']
          : base == 'rent_units'
          ? d.keys().hasOnly(['propertyId', 'label', 'rent', 'leaseId', 'lastReading', 'meterRate', 'meterCharge'].concat(rentMeta()))
            && rentStr(d, 'propertyId', 1, 64) && rentStr(d, 'label', 1, 60) && rentMoney(d, 'rent')
            && (d.get('leaseId', null) == null || rentStr(d, 'leaseId', 1, 64))
            && rentNumOrNull(d, 'lastReading') && rentNumOrNull(d, 'meterRate')
            && (d.get('meterCharge', null) == null || rentStr(d, 'meterCharge', 1, 80))
          : base == 'rent_tenants'
          ? d.keys().hasOnly(['name', 'phone', 'notes'].concat(rentMeta()))
            && rentStr(d, 'name', 1, 80) && rentStr(d, 'phone', 0, 20) && rentStr(d, 'notes', 0, 500)
          : base == 'rent_leases'
          ? d.keys().hasOnly(['unitId', 'propertyId', 'tenantId', 'rent', 'dueDay', 'startMonth', 'endMonth',
                              'deposit', 'status', 'chargedThrough', 'increasePct', 'rentSince'].concat(rentMeta()))
            && rentStr(d, 'unitId', 1, 64) && rentStr(d, 'propertyId', 1, 64) && rentStr(d, 'tenantId', 1, 64)
            && rentMoney(d, 'rent') && rentMoney(d, 'deposit')
            && d.get('dueDay', 0) is int && d.dueDay >= 1 && d.dueDay <= 28
            && rentMonth(d.get('startMonth', null))
            && (d.get('endMonth', null) == null || rentMonth(d.endMonth))
            && d.get('status', '') in ['active', 'ended']
            && (d.get('chargedThrough', null) == null || rentMonth(d.chargedThrough))
            && (!('increasePct' in d) || (d.increasePct is number && d.increasePct >= 0 && d.increasePct <= 100))
            && (!('rentSince' in d) || rentMonth(d.rentSince))
          : false);
    }

    // New leases start active, with no charges, and take their unit in the same write.
    function rentLeaseCreateOk(usersCol, docId) {
      let d = request.resource.data;
      return d.get('chargedThrough', null) == null
        && d.get('status', '') == 'active' && d.get('endMonth', null) == null
        && getAfter(rentPath(usersCol, 'rent_units', d.unitId)).data.get('leaseId', null) == docId;
    }

    // Lease changes (review of #10, High):
    //  - an ended lease is final: status, endMonth and chargedThrough never change again;
    //  - an active lease stays active with endMonth null, and chargedThrough moves
    //    forward exactly one month per write, to a month whose charge exists after
    //    the write and that isn't after this month (IST);
    //  - active -> ended only in the move-out write: endMonth (start..this month) =
    //    chargedThrough, its charge exists, the unit is freed in the same write.
    //    Ending before the last charged month deletes the later unpaid months and
    //    is owner/manager only.
    function rentLeaseUpdateOk(usersCol, docId, mgr) {
      let d = request.resource.data;
      let r = resource.data;
      let before = r.get('chargedThrough', null);
      let next = d.get('chargedThrough', null);
      return validRentDoc('rent_leases') && rentCreationKept()
        && d.startMonth == r.startMonth && d.unitId == r.unitId && d.tenantId == r.tenantId
        && (r.status == 'ended'
          ? d.status == 'ended' && d.get('endMonth', null) == r.get('endMonth', null) && next == before
          : d.status == 'active'
            ? d.get('endMonth', null) == null
              && (next == before
                  || (next == (before == null ? d.startMonth : nextMonth(before))
                      && next <= rentThisMonth()
                      && existsAfter(rentChargePath(usersCol, docId, next))))
            : rentMonth(d.get('endMonth', null))
              && d.endMonth >= d.startMonth && d.endMonth <= rentThisMonth()
              && next == d.endMonth && before != null
              && existsAfter(rentChargePath(usersCol, docId, next))
              && getAfter(rentPath(usersCol, 'rent_units', d.unitId)).data.get('leaseId', '') == null
              && (next == before
                  || (next < before && mgr
                      && !existsAfter(rentChargePath(usersCol, docId, before)))));
    }

    // A unit's lease link changes only with the lease: set by a new active lease
    // for this unit, cleared when that lease ends in the same write.
    function rentUnitLeaseOk(usersCol, docId) {
      let before = resource.data.get('leaseId', null);
      let next = request.resource.data.get('leaseId', null);
      return next == before
        || (before == null && next != null
            && !exists(rentLeasePath(usersCol, next))
            && getAfter(rentLeasePath(usersCol, next)).data.unitId == docId
            && getAfter(rentLeasePath(usersCol, next)).data.status == 'active')
        || (before != null && next == null
            && getAfter(rentLeasePath(usersCol, before)).data.status == 'ended');
    }

    // lastReading / meterRate move only with a meter write on a charge of this
    // unit (meterCharge points at it); owner/manager may also set the rate alone.
    function rentUnitMeterOk(usersCol, docId, mgr) {
      let d = request.resource.data;
      let r = resource.data;
      let meterKeys = d.diff(r).affectedKeys().intersection(['lastReading', 'meterRate', 'meterCharge'].toSet());
      return meterKeys.size() == 0
        || (mgr && meterKeys.hasOnly(['meterRate']))
        || (rentStr(d, 'meterCharge', 1, 80)
            && getAfter(rentPath(usersCol, 'rent_charges', d.meterCharge)).data.unitId == docId
            && getAfter(rentPath(usersCol, 'rent_charges', d.meterCharge)).data.electricity.curr == d.lastReading
            && getAfter(rentPath(usersCol, 'rent_charges', d.meterCharge)).data.electricity.rate == d.meterRate);
    }

    function rentChargeFields() {
      return ['leaseId', 'unitId', 'propertyId', 'tenantId', 'tenantName', 'unitLabel', 'month', 'dueDay',
              'rent', 'electricity', 'amount', 'paid', 'open', 'payments', 'createdAt', 'updatedAt', 'updatedBy'];
    }

    // rent_charges/{leaseId}_{YYYY-MM}: created only in the write that moves its
    // active lease's chargedThrough to exactly this month; amount = the lease's
    // rent; nothing paid, no electricity yet.
    function validRentChargeCreate(usersCol, docId) {
      let d = request.resource.data;
      let lease = getAfter(rentLeasePath(usersCol, d.get('leaseId', '-'))).data;
      return d.keys().hasOnly(rentChargeFields())
        && rentWriterOk()
        && rentStr(d, 'leaseId', 1, 64) && rentMonth(d.get('month', null))
        && docId == d.leaseId + '_' + d.month
        && lease.status == 'active'
        && lease.get('chargedThrough', null) == d.month
        && get(rentLeasePath(usersCol, d.leaseId)).data.get('chargedThrough', null) != d.month
        && d.get('unitId', '') == lease.unitId && d.get('tenantId', '') == lease.tenantId
        && d.get('propertyId', '') == lease.propertyId && d.get('dueDay', 0) == lease.dueDay
        && d.get('amount', null) == lease.rent && d.get('rent', null) == lease.rent
        && d.get('electricity', null) == null
        && d.get('paid', null) == 0 && d.get('payments', null) == []
        && d.get('open', null) == (lease.rent > 0)
        && rentStr(d, 'tenantName', 0, 80) && rentStr(d, 'unitLabel', 0, 60);
    }

    // Σ amount of up to 12 payment entries (rules have no loops; a charge holds at most 12).
    function rentPayAt(list, i) {
      return list.size() > i ? list[i].amount : 0;
    }

    function rentPaidSum(list) {
      return rentPayAt(list, 0) + rentPayAt(list, 1) + rentPayAt(list, 2) + rentPayAt(list, 3)
        + rentPayAt(list, 4) + rentPayAt(list, 5) + rentPayAt(list, 6) + rentPayAt(list, 7)
        + rentPayAt(list, 8) + rentPayAt(list, 9) + rentPayAt(list, 10) + rentPayAt(list, 11);
    }

    // One new payment entry by the caller (amount > 0, known mode), at most 12 per charge.
    function rentNewEntryOk() {
      let list = request.resource.data.payments;
      let n = resource.data.get('payments', []).size();
      return appendsOneEntry('payments') && n < 12
        && list[n].keys().hasOnly(['amount', 'mode', 'ref', 'date', 'at', 'by', 'byName'])
        && list[n].amount > 0
        && list[n].get('by', null) == request.auth.uid
        && list[n].get('mode', '') in ['cash', 'upi', 'bank', 'cheque'];
    }

    // A payment (rent-store.js recordPayment): paid grows by exactly the new
    // entry and never above the amount due.
    function rentPaymentOk() {
      let d = request.resource.data;
      let r = resource.data;
      let n = r.get('payments', []).size();
      return d.diff(r).affectedKeys().hasOnly(['payments', 'paid', 'open', 'updatedAt', 'updatedBy'])
        && rentWriterOk()
        && rentNewEntryOk()
        && d.get('paid', null) is number
        && d.paid >= r.paid + d.payments[n].amount - 0.01
        && d.paid <= r.paid + d.payments[n].amount + 0.01
        && d.paid <= r.amount + 0.01
        && d.get('open', null) == (d.paid < r.amount - 0.001);
    }

    // Electricity from a sub-meter (rent-store.js recordMeter): units = current −
    // previous, amount = units × rate, charge = rent + electricity (rent unchanged).
    // Previous = the reading already on this charge, else the unit's last reading;
    // rate = the unit's rate unless owner/manager; replacing a saved reading is
    // owner/manager only; the unit stores the new reading in the same write.
    function rentMeterOk(usersCol, docId, mgr) {
      let d = request.resource.data;
      let r = resource.data;
      let e = d.get('electricity', null);
      let old = r.get('electricity', null);
      let unit = get(rentPath(usersCol, 'rent_units', r.unitId)).data;
      let unitAfter = getAfter(rentPath(usersCol, 'rent_units', r.unitId)).data;
      return d.diff(r).affectedKeys().hasOnly(['electricity', 'amount', 'open', 'updatedAt', 'updatedBy'])
        && rentWriterOk()
        && e is map && e.keys().hasOnly(['prev', 'curr', 'rate', 'units', 'amount'])
        && e.get('prev', null) is number && e.get('curr', null) is number && e.get('rate', null) is number
        && e.get('units', null) is number && e.get('amount', null) is number
        && e.prev >= 0 && e.curr >= e.prev && e.rate >= 0
        && (old == null || mgr)
        && (old != null ? e.prev == old.prev : (unit.get('lastReading', null) == null || e.prev == unit.lastReading))
        && (mgr || unit.get('meterRate', null) == null || e.rate == unit.meterRate)
        && unitAfter.get('meterCharge', null) == docId
        && unitAfter.get('lastReading', null) == e.curr && unitAfter.get('meterRate', null) == e.rate
        && e.units >= e.curr - e.prev - 0.01 && e.units <= e.curr - e.prev + 0.01
        && e.amount >= e.units * e.rate - 0.01 && e.amount <= e.units * e.rate + 0.01
        && d.get('amount', null) is number
        && d.amount >= r.rent + e.amount - 0.01 && d.amount <= r.rent + e.amount + 0.01
        && d.amount >= r.paid - 0.01
        && d.get('open', null) == (r.paid < d.amount - 0.001);
    }

    // Owner/manager corrections (e.g. a waived month): same lease, month and
    // creation; payments unchanged or one new own entry; paid = Σ entries ≤ amount.
    function rentChargeEditOk() {
      let d = request.resource.data;
      let r = resource.data;
      return d.keys().hasOnly(rentChargeFields())
        && rentWriterOk() && rentCreationKept()
        && d.get('leaseId', null) == r.leaseId && d.get('month', null) == r.month
        && d.get('unitId', null) == r.unitId && d.get('tenantId', null) == r.tenantId
        && d.get('electricity', null) == r.get('electricity', null) && d.get('rent', null) == r.get('rent', null)
        && rentMoney(d, 'amount') && rentMoney(d, 'paid')
        && d.get('payments', null) is list
        && (d.payments == r.get('payments', []) || rentNewEntryOk())
        && d.payments.size() <= 12
        && rentPaidMatches(d.paid, rentPaidSum(d.payments))
        && d.paid <= d.amount + 0.01
        && d.get('open', null) == (d.paid < d.amount - 0.001);
    }

    function rentPaidMatches(paid, sum) {
      return paid >= sum - 0.01 && paid <= sum + 0.01;
    }

    // Move-out removes unpaid months after the last month, only inside the
    // move-out write (lease active before, ended after); owner/manager only.
    function rentChargeDeleteOk(usersCol, mgr) {
      let leaseBefore = get(rentLeasePath(usersCol, resource.data.leaseId)).data;
      let leaseAfter = getAfter(rentLeasePath(usersCol, resource.data.leaseId)).data;
      return mgr
        && resource.data.get('paid', 0) == 0 && resource.data.get('payments', []).size() == 0
        && leaseBefore.status == 'active' && leaseAfter.status == 'ended'
        && resource.data.month > leaseAfter.endMonth;
    }

    function rentCreateOk(base, usersCol, docId) {
      return canWriteRent(usersCol)
        && (base == 'rent_charges' ? validRentChargeCreate(usersCol, docId)
          : base == 'rent_leases' ? validRentDoc(base) && rentLeaseCreateOk(usersCol, docId)
          : base == 'rent_units' ? validRentDoc(base) && request.resource.data.get('leaseId', null) == null
            && request.resource.data.get('lastReading', null) == null && request.resource.data.get('meterCharge', null) == null
          : validRentDoc(base));
    }

    // The caller's rentals role is read once per rule (rules have an expression budget).
    function rentUpdateOk(base, usersCol, docId) {
      let role = rentRoleIn(usersCol);
      let mgr = role in ['owner', 'manager'];
      return role != '' && rentUpdateAs(base, usersCol, docId, mgr);
    }

    function rentUpdateAs(base, usersCol, docId, mgr) {
      return base == 'rent_charges'
          ? (rentCreationKept() && (rentPaymentOk() || rentMeterOk(usersCol, docId, mgr)))
            || (mgr && rentChargeEditOk())
        : base == 'rent_leases'
          ? rentLeaseUpdateOk(usersCol, docId, mgr)
        : base == 'rent_units'
          ? validRentDoc(base) && rentCreationKept()
            && rentUnitLeaseOk(usersCol, docId) && rentUnitMeterOk(usersCol, docId, mgr)
        : validRentDoc(base) && rentCreationKept();
    }

    function rentDeleteOk(base, usersCol) {
      return isOwnerIn(usersCol)
        || (base == 'rent_charges' && resource != null && rentChargeDeleteOk(usersCol, canManageRent(usersCol)));
    }

    // Audit entries for rentals actions from users with a rentals role (a
    // rentals-only helper isn't approved for the shop).
    function rentAuditOk(usersCol) {
      return request.resource.data.get('action', '') is string
        && request.resource.data.action.matches('RENT_[A-Z_]{1,40}')
        && rentRoleIn(usersCol) != '';
    }

    // ============================================
    // PRODUCTION COLLECTIONS
    // ============================================

    // Business collections (production and dev_ mirrors) live under one wildcard match.
    match /{collection}/{docId} {
      allow read: if businessAccess(collection);
      // Stock records need an up-to-date app (clientVersion >= 3) on create/update.
      allow create: if businessAccess(collection)
        && appSettingsGuard(collection, docId)
        && (!(collection in stockCollections()) || writesCurrentClient(collection))
        && canCreateRecord(baseName(collection), usersOf(collection));
      // Bills: full edits by owner/manager/creator; anyone else approved may only
      // record payment/due bookkeeping. Only an owner may change userId.
      // Cash, expenses, stock adjustments, items, counters: see canUpdateRecord.
      allow update: if businessAccess(collection)
        && appSettingsGuard(collection, docId)
        && (!(collection in stockCollections()) || writesCurrentClient(collection))
        && canUpdateRecord(baseName(collection), usersOf(collection), docId);
      // Bills can only be deleted by an owner or by the user who created them
      // (matches the client check in history.js deleteBill). Cash sessions,
      // items and counters: owner only. Expenses: owner/manager, or the creator
      // within 24 hours. Withdrawals/stock adjustments: owner/manager.
      allow delete: if businessAccess(collection)
        && appSettingsGuard(collection, docId)
        && canDeleteRecord(baseName(collection), usersOf(collection));
    }

    // State/lease writes: owner or manager only; anyone approved may mark it stale.
    // legacyScan (backfill completion state): owner/manager only, so staff can't
    // switch the backfill off; staff devices still backfill and ignore the denied
    // state write. Other docs: any approved user.
    match /stockCheckpoints/{docId} {
      allow read: if isApproved();
      allow create, update: if checkpointRules('users', docId);
      allow delete: if isManagerIn('users');
    }

    match /dev_stockCheckpoints/{docId} {
      allow read: if isApprovedIn('dev_users');
      allow create, update: if checkpointRules('dev_users', docId);
      allow delete: if isManagerIn('dev_users');
    }

    match /rateHistory/{docId} {
      allow read: if isManagerIn('users');
      allow create: if validRateHistoryEntry('users');
      allow update, delete: if false;
    }

    match /dev_rateHistory/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create: if validRateHistoryEntry('dev_users');
      allow update, delete: if false;
    }

    // --- anomalies (#187 / #40): found by the daily scan on owner/manager
    // devices; only owner/manager may read them or mark them OK/fixed (#84 is
    // still open, so other users see nothing). Only an owner may delete.
    function validAnomaly(usersCol) {
      let d = request.resource.data;
      return isManagerIn(usersCol)
        && d.keys().hasOnly(['type', 'rule', 'severity', 'en', 'hi', 'refKind', 'refId', 'billType', 'billNumber',
                             'party', 'item', 'userId', 'user', 'amount', 'at', 'dayKey', 'hour', 'detectedBy',
                             'detectedAt', 'status', 'note', 'reviewedBy', 'reviewedByName', 'reviewedAt'])
        && d.keys().hasAll(['type', 'severity', 'dayKey', 'status'])
        && d.type is string && d.dayKey is string
        && d.severity in ['high', 'medium', 'low']
        && d.status in ['open', 'ok', 'fixed'];
    }

    match /anomalies/{docId} {
      allow read: if isManagerIn('users');
      allow create, update: if validAnomaly('users');
      allow delete: if isOwnerIn('users');
    }

    match /dev_anomalies/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create, update: if validAnomaly('dev_users');
      allow delete: if isOwnerIn('dev_users');
    }

    // --- rate trends (#65): per-item-year rate stats + backfill status ---
    // rateStats/{itemId}_{YYYY} holds weekly (weeks: {'wYYYY-MM-DD': bucket})
    // and monthly (months: {'mYYYY-MM': bucket}) buckets of one item and year;
    // rateStats/_meta is the backfill status. Owner/manager only. Bucket maps
    // are size-capped (rules can't check every bucket; the app writes them).
    function validRateStats(usersCol, docId) {
      let d = request.resource.data;
      return isManagerIn(usersCol)
        && (docId == '_meta'
          ? d.keys().hasOnly(['backfillDone', 'backfillAt', 'bills', 'reads', 'months', 'by', 'byUserId', 'startedAt'])
          : d.keys().hasOnly(['itemId', 'year', 'weeks', 'months', 'updatedAt'])
            && d.keys().hasAll(['itemId', 'year', 'weeks', 'months'])
            && d.itemId is string && d.itemId.size() > 0
            && d.year is string && d.year.matches('^[0-9]{4}$')
            && docId == d.itemId + '_' + d.year
            && d.weeks is map && d.weeks.size() <= 54
            && d.months is map && d.months.size() <= 12);
    }

    match /rateStats/{docId} {
      allow read: if isManagerIn('users');
      allow create, update: if validRateStats('users', docId);
      allow delete: if isOwnerIn('users');
    }

    match /dev_rateStats/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create, update: if validRateStats('dev_users', docId);
      allow delete: if isOwnerIn('dev_users');
    }

    // --- Test in Production (#217) ---
    // tipHealth/{deviceId}_{YYYYMMDD}: daily per-device counters, written with
    // set+merge and FieldValue.increment. Any approved user may create/update
    // only their own device docs (uid, deviceId and day can't change); the
    // per-version map is capped. tipFailures/{deviceId}_{YYYYMMDD}_{1..20}:
    // create-only samples, so at most 20 per device per day. Owner/manager read.
    function validTipHealth(usersCol, docId) {
      let d = request.resource.data;
      return isApprovedIn(usersCol)
        && d.keys().hasOnly(['uid', 'deviceId', 'day', 'platform', 'appVersion', 'buildId', 'updatedAt', 'v'])
        && d.keys().hasAll(['uid', 'deviceId', 'day', 'v'])
        && d.uid == request.auth.uid
        && d.deviceId is string && d.deviceId.matches('^[a-z0-9]{6,20}$')
        && d.day is string && d.day.matches('^[0-9]{8}$')
        && docId == d.deviceId + '_' + d.day
        && d.v is map && d.v.size() <= 4
        && shortStringOrAbsent(d, 'platform', 16)
        && shortStringOrAbsent(d, 'appVersion', 20)
        && shortStringOrAbsent(d, 'buildId', 64)
        && (!('updatedAt' in d) || d.updatedAt == request.time)
        && (resource == null
            || (resource.data.uid == request.auth.uid
                && resource.data.deviceId == d.deviceId
                && resource.data.day == d.day));
    }

    function validTipFailure(usersCol, docId) {
      let d = request.resource.data;
      return isApprovedIn(usersCol)
        && d.keys().hasOnly(['uid', 'deviceId', 'day', 'test', 'result', 'reason', 'reasonName', 'flags', 'props',
                             'errors', 'durationMs', 'appVersion', 'buildId', 'platform', 'at', 'createdAt'])
        && d.keys().hasAll(['uid', 'deviceId', 'day', 'test', 'result', 'reason', 'at'])
        && d.uid == request.auth.uid
        && d.deviceId is string && d.deviceId.matches('^[a-z0-9]{6,20}$')
        && d.day is string && d.day.matches('^[0-9]{8}$')
        && docId.matches('^' + d.deviceId + '_' + d.day + '_([1-9]|1[0-9]|20)$')
        && d.test is string && d.test.size() <= 32
        && d.result in ['fail', 'abandoned', 'expired', 'rolled_back']
        && d.reason is int && d.reason >= 0 && d.reason <= 32767
        && d.at is number
        && (!('flags' in d) || (d.flags is map && d.flags.size() <= 12))
        && (!('props' in d) || (d.props is map && d.props.size() <= 12))
        && shortStringOrAbsent(d, 'reasonName', 40)
        && shortStringOrAbsent(d, 'appVersion', 20)
        && shortStringOrAbsent(d, 'buildId', 64)
        && shortStringOrAbsent(d, 'platform', 16)
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    match /tipHealth/{docId} {
      allow read: if isManagerIn('users');
      allow create, update: if validTipHealth('users', docId);
      allow delete: if isOwnerIn('users');
    }

    match /dev_tipHealth/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create, update: if validTipHealth('dev_users', docId);
      allow delete: if isOwnerIn('dev_users');
    }

    match /tipFailures/{docId} {
      allow read: if isManagerIn('users');
      allow create: if validTipFailure('users', docId);
      allow update: if false;
      allow delete: if isOwnerIn('users');
    }

    match /dev_tipFailures/{docId} {
      allow read: if isManagerIn('dev_users');
      allow create: if validTipFailure('dev_users', docId);
      allow update: if false;
      allow delete: if isOwnerIn('dev_users');
    }

    match /users/{userId} {
      allow read: if canReadProfile('users', userId);
      allow create: if canCreateProfile(userId);
      allow update: if canUpdateProfile('users', userId);
      allow delete: if isAdmin();
    }

    match /users/{userId}/preferences/{prefId} {
      allow read, write: if isApproved() && request.auth.uid == userId;
    }

    // Audit logs - approved users append entries as themselves; only owners read,
    // and only owners delete entries older than 90 days (retention cleanup).
    match /auditLogs/{logId} {
      allow create: if (isApproved() || rentAuditOk('users')) && validAuditEntry();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin() && isExpiredAuditEntry();
    }

    // Telemetry - append-only error reports; only owners read/delete (Clear All).
    match /telemetry/{docId} {
      allow create: if isApproved() && validTelemetryEntry();
      allow update: if false;
      allow read, delete: if isAdmin();
    }

    // Rentals (#170): helpers above. Deletes: owner, or move-out removing unpaid later months.
    match /rent_properties/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_properties', 'users', docId);
      allow update: if rentUpdateOk('rent_properties', 'users', docId);
      allow delete: if rentDeleteOk('rent_properties', 'users');
    }

    match /rent_units/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_units', 'users', docId);
      allow update: if rentUpdateOk('rent_units', 'users', docId);
      allow delete: if rentDeleteOk('rent_units', 'users');
    }

    match /rent_tenants/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_tenants', 'users', docId);
      allow update: if rentUpdateOk('rent_tenants', 'users', docId);
      allow delete: if rentDeleteOk('rent_tenants', 'users');
    }

    match /rent_leases/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_leases', 'users', docId);
      allow update: if rentUpdateOk('rent_leases', 'users', docId);
      allow delete: if rentDeleteOk('rent_leases', 'users');
    }

    match /rent_charges/{docId} {
      allow read: if rentRoleIn('users') != '';
      allow create: if rentCreateOk('rent_charges', 'users', docId);
      allow update: if rentUpdateOk('rent_charges', 'users', docId);
      allow delete: if rentDeleteOk('rent_charges', 'users');
    }

    match /dev_rent_properties/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_properties', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_properties', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_properties', 'dev_users');
    }

    match /dev_rent_units/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_units', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_units', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_units', 'dev_users');
    }

    match /dev_rent_tenants/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_tenants', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_tenants', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_tenants', 'dev_users');
    }

    match /dev_rent_leases/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_leases', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_leases', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_leases', 'dev_users');
    }

    match /dev_rent_charges/{docId} {
      allow read: if rentRoleIn('dev_users') != '';
      allow create: if rentCreateOk('rent_charges', 'dev_users', docId);
      allow update: if rentUpdateOk('rent_charges', 'dev_users', docId);
      allow delete: if rentDeleteOk('rent_charges', 'dev_users');
    }

    // ============================================
    // DEVELOPMENT ENVIRONMENT COLLECTIONS (dev_ prefix)
    // Same rules as production, with dev_users as the profile source.
    // ============================================

    match /dev_users/{userId} {
      allow read: if canReadProfile('dev_users', userId);
      allow create: if canCreateProfile(userId);
      allow update: if canUpdateProfile('dev_users', userId);
      allow delete: if isOwnerIn('dev_users');
    }

    match /dev_users/{userId}/preferences/{prefId} {
      allow read, write: if isApprovedIn('dev_users') && request.auth.uid == userId;
    }

    match /dev_auditLogs/{logId} {
      allow create: if (isApprovedIn('dev_users') || rentAuditOk('dev_users')) && validAuditEntry();
      allow read: if isOwnerIn('dev_users');
      allow update: if false;
      allow delete: if isOwnerIn('dev_users') && isExpiredAuditEntry();
    }

    match /dev_telemetry/{docId} {
      allow create: if isApprovedIn('dev_users') && validTelemetryEntry();
      allow update: if false;
      allow read, delete: if isOwnerIn('dev_users');
    }
  }
}

{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": []
  },
  "include": ["types/happa.d.ts", "www/js/**/*.js"],
  "exclude": ["www/js/__tests__/**"]
}

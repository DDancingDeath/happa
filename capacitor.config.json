{
  "appId": "com.happa",
  "appName": "happa",
  "webDir": "www",
  "server": {
    "allowNavigation": [
      "*.firebaseapp.com",
      "*.googleapis.com",
      "*.gstatic.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#2196F3",
      "showSpinner": false
    }
  }
}
